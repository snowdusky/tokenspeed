// V4.1 router top-k: sqrt-softplus scores, optional selection-only bias,
// renormalisation and routed scaling, all in FP32 on the vector unit.
//
// Contract (mirrors torch_sqrt_softplus_topk in tokenspeed-kernel/ops/moe):
//   scores      = sqrt(softplus(logits))          (FP32, bias never applied)
//   key         = scores + correction_bias        (selection only)
//   ids         = top-k(key, sorted)              (ties -> lowest index first)
//   weights     = scores[ids]; renormalise; * routed_scaling_factor
// and ids are returned as int32 while weights use the caller's dtype.
//
// Two properties are load bearing and were both wrong in the prototype:
//
//   1. The score function is sqrt(softplus), not sigmoid/silu. softplus is
//      evaluated as max(x, 0) + log(1 + exp(-|x|)) so large logits cannot
//      overflow Exp and small ones keep full fp32 relative accuracy.
//   2. A pass removes exactly one candidate: the mask compares the *index*
//      vector against the winning index, never the scores against the maximum.
//      Masking by |score - max| deletes every entry that ties the maximum, and
//      the accumulated weight sum then counts several experts at once.
//
// Tie policy: the winner of a pass is the lowest index among the entries equal
// to the running maximum, and only that index is removed, so a later pass can
// still pick the other tied entry. torch.topk does not promise a tie order on
// the platform, so ties crossing the k-th place may select a different-but-
// equally-valid expert set; the ids are bit-identical for distinct score rows.

#define ASCENDC_CUBE_ONLY
#include "kernel_operator.h"
using namespace AscendC;

constexpr int MAXE = 512;    // widest router the kernel handles (V4.1 runs 448)
constexpr int KTOP = 8;      // deepest top-k the kernel handles
constexpr float BIG = 1e9f;  // sentinel for "definitely not the minimum index"

constexpr int LOGIT_FP32 = 0;
constexpr int LOGIT_BF16 = 1;
constexpr int LOGIT_FP16 = 2;

struct TopkShape {
    int rows;
    int experts;
    int k;
    float scale;      // routed_scaling_factor
    int renormalize;  // 1 -> selected weights sum to one
    int in_dtype;     // DT_*; logits dtype, always scored in fp32
    int out_dtype;    // 0 -> fp32 weights, 1 -> bf16 weights
};

__global__ __aicore__ void router_topk(GM_ADDR lp, GM_ADDR biasp, GM_ADDR idsp, GM_ADDR wsp, TopkShape s) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    TBuf<TPosition::VECCALC> fb, kb, sb, ib, vb, wb, xb, cvb, mb, cb, idb, iib, wfb, wbb;
    // 8 row-width buffers at MAXE floats is ~19 KiB of the 192 KiB UB, so the
    // width bound is about how many experts a single row can hold, not space.
    pipe.InitBuffer(fb, MAXE * 4);      // logits, fp32
    pipe.InitBuffer(kb, MAXE * 4);      // selection key = score + bias
    pipe.InitBuffer(sb, MAXE * 4);      // unbiased scores
    pipe.InitBuffer(ib, MAXE * 4);      // expert index vector
    pipe.InitBuffer(vb, MAXE * 4);      // pass scratch / bias staging
    pipe.InitBuffer(wb, MAXE * 4);      // reduction work area (never aliases a source)
    pipe.InitBuffer(xb, MAXE * 4);      // pass scratch
    pipe.InitBuffer(cvb, 2 * MAXE * 4); // BIG and -BIG constants
    pipe.InitBuffer(mb, 2 * (MAXE / 8));  // two bit-packed compare masks (1 bit per lane)
    pipe.InitBuffer(cb, MAXE * 2);      // 2-byte logits staging (bf16/fp16)
    pipe.InitBuffer(idb, KTOP * 4);     // selected ids, fp32 staging
    pipe.InitBuffer(iib, KTOP * 4);     // selected ids, int32
    pipe.InitBuffer(wfb, KTOP * 4);     // selected weights, fp32
    pipe.InitBuffer(wbb, KTOP * 2);     // selected weights, bf16

    auto raw = fb.Get<float>();
    auto key = kb.Get<float>();
    auto score = sb.Get<float>();
    auto iota = ib.Get<float>();
    auto sel = vb.Get<float>();
    auto work = wb.Get<float>();
    auto tmp = xb.Get<float>();
    auto bigIndex = cvb.Get<float>()[0];
    auto removed = cvb.Get<float>()[MAXE];
    auto maskMax = mb.Get<uint8_t>();
    auto maskOne = mb.Get<uint8_t>()[MAXE / 8];
    auto rawb = cb.Get<bfloat16_t>();
    auto rawh = cb.Get<half>();
    auto idf = idb.Get<float>();
    auto idi = iib.Get<int32_t>();
    auto wf = wfb.Get<float>();
    auto wbf = wbb.Get<bfloat16_t>();

    GlobalTensor<float> L32, B32, W32;
    GlobalTensor<bfloat16_t> L16, W16;
    GlobalTensor<half> LH;
    GlobalTensor<int32_t> IDS;
    L32.SetGlobalBuffer((__gm__ float*)lp);
    L16.SetGlobalBuffer((__gm__ bfloat16_t*)lp);
    LH.SetGlobalBuffer((__gm__ half*)lp);
    B32.SetGlobalBuffer((__gm__ float*)biasp);
    W32.SetGlobalBuffer((__gm__ float*)wsp);
    W16.SetGlobalBuffer((__gm__ bfloat16_t*)wsp);
    IDS.SetGlobalBuffer((__gm__ int32_t*)idsp);

    const int E = s.experts;
    const int K = s.k;
    const bool hasBias = biasp != nullptr;
    const bool bf16Out = s.out_dtype == 1;

    // Constants and the index vector are row independent. SetValue writes with
    // the scalar pipe, so the vector passes need an S->V barrier before reading.
    Duplicate(bigIndex, BIG, MAXE);
    Duplicate(removed, -BIG, MAXE);
    for (int i = 0; i < E; ++i) iota.SetValue(i, (float)i);
    PipeBarrier<PIPE_ALL>();

    for (int row = GetBlockIdx(); row < s.rows; row += GetBlockNum()) {
        // MTE2 cannot start while the previous row's stores still read the
        // staging and output buffers (symptom: first row right, later rows stale).
        SetFlag<HardEvent::MTE3_MTE2>(0);
        WaitFlag<HardEvent::MTE3_MTE2>(0);
        if (s.in_dtype == LOGIT_FP32) {
            DataCopyPad(raw, L32[(int64_t)row * E], DataCopyExtParams{1, uint32_t(E * 4), 0, 0, 0},
                        DataCopyPadExtParams<float>{false, 0, 0, 0});
        } else if (s.in_dtype == LOGIT_BF16) {
            DataCopyPad(rawb, L16[(int64_t)row * E], DataCopyExtParams{1, uint32_t(E * 2), 0, 0, 0},
                        DataCopyPadExtParams<bfloat16_t>{false, 0, 0, 0});
        } else {
            DataCopyPad(rawh, LH[(int64_t)row * E], DataCopyExtParams{1, uint32_t(E * 2), 0, 0, 0},
                        DataCopyPadExtParams<half>{false, 0, 0, 0});
        }
        if (hasBias) {
            DataCopyPad(sel, B32[0], DataCopyExtParams{1, uint32_t(E * 4), 0, 0, 0},
                        DataCopyPadExtParams<float>{false, 0, 0, 0});
        }
        SetFlag<HardEvent::MTE2_V>(0);
        WaitFlag<HardEvent::MTE2_V>(0);
        if (s.in_dtype == LOGIT_BF16) {
            Cast(raw, rawb, RoundMode::CAST_NONE, E);
            PipeBarrier<PIPE_V>();
        } else if (s.in_dtype == LOGIT_FP16) {
            Cast(raw, rawh, RoundMode::CAST_NONE, E);
            PipeBarrier<PIPE_V>();
        }

        // scores = sqrt(max(x, 0) + log1p(exp(-|x|)))
        //
        // log(1 + t) loses relative accuracy once t is small: at t = 2e-9 the
        // fp32 rounding of 1 + t carries enough absolute error to make the
        // result meaningless (x = -20 came out as exactly 0). Those experts
        // still carry routing *weights*, so take the series t - t^2/2 instead
        // when t is below 1e-3, where the next term is O(t^3/3) = 3e-10 of t.
        //
        // `sel` holds the bias for this row and must not be touched here.
        Abs(tmp, raw, E);
        PipeBarrier<PIPE_V>();
        Muls(tmp, tmp, -1.0f, E);
        PipeBarrier<PIPE_V>();
        Exp(tmp, tmp, E);                 // t = exp(-|x|)
        PipeBarrier<PIPE_V>();
        Adds(key, tmp, 1.0f, E);
        PipeBarrier<PIPE_V>();
        Ln(key, key, E);                  // log1p(t), accurate while t is not tiny
        PipeBarrier<PIPE_V>();
        Mul(score, tmp, tmp, E);
        PipeBarrier<PIPE_V>();
        Muls(score, score, -0.5f, E);
        PipeBarrier<PIPE_V>();
        Add(score, score, tmp, E);        // t - t^2/2
        PipeBarrier<PIPE_V>();
        CompareScalar(maskMax, tmp, 1e-3f, CMPMODE::LT, E);
        PipeBarrier<PIPE_V>();
        Select(work, maskMax, score, key, SELMODE::VSEL_TENSOR_TENSOR_MODE, E);
        PipeBarrier<PIPE_V>();
        Maxs(score, raw, 0.0f, E);
        PipeBarrier<PIPE_V>();
        Add(score, score, work, E);
        PipeBarrier<PIPE_V>();
        Sqrt(score, score, E);
        PipeBarrier<PIPE_V>();

        // key = scores + bias; the bias must never reach the weights.
        if (hasBias) {
            Add(key, score, sel, E);
            PipeBarrier<PIPE_V>();
        } else {
            Adds(key, score, 0.0f, E);
            PipeBarrier<PIPE_V>();
        }

        float weightSum = 0.0f;
        for (int j = 0; j < K; ++j) {
            ReduceMax<float>(sel, key, work, E, false);
            SetFlag<HardEvent::V_S>(0);
            WaitFlag<HardEvent::V_S>(0);
            const float mx = sel.GetValue(0);

            // Lowest index among the entries equal to the running maximum.
            CompareScalar(maskMax, key, mx, CMPMODE::EQ, E);
            PipeBarrier<PIPE_V>();
            Select(sel, maskMax, iota, bigIndex, SELMODE::VSEL_TENSOR_TENSOR_MODE, E);
            PipeBarrier<PIPE_V>();
            ReduceMin<float>(tmp, sel, work, E, false);
            SetFlag<HardEvent::V_S>(0);
            WaitFlag<HardEvent::V_S>(0);
            const float win = tmp.GetValue(0);

            // Exactly one bit set: index equality is exact, so no tie or
            // rounding artefact can widen this mask. The weight is the unbiased
            // score at that index, read straight out of UB: the reference does
            // scores.gather(ids), so a masked reduce could only add error.
            CompareScalar(maskOne, iota, win, CMPMODE::EQ, E);
            PipeBarrier<PIPE_V>();
            SetFlag<HardEvent::V_S>(0);
            WaitFlag<HardEvent::V_S>(0);
            const int winner = (int)win;
            const float weight = score.GetValue(winner);

            idf.SetValue(j, win);
            wf.SetValue(j, weight);
            weightSum += weight;

            // Drop only the winner: every other entry keeps its key, including
            // entries tied with the maximum.
            Select(tmp, maskOne, removed, key, SELMODE::VSEL_TENSOR_TENSOR_MODE, E);
            PipeBarrier<PIPE_V>();
            Adds(key, tmp, 0.0f, E);
            PipeBarrier<PIPE_V>();
        }

        // renormalise then scale, in the reference order.
        SetFlag<HardEvent::S_V>(0);
        WaitFlag<HardEvent::S_V>(0);
        if (s.renormalize) {
            const float denominator = weightSum > 1.17549435e-38f ? weightSum : 1.17549435e-38f;
            Duplicate(work, denominator, K);
            PipeBarrier<PIPE_V>();
            Div(wf, wf, work, K);
            PipeBarrier<PIPE_V>();
        }
        Muls(wf, wf, s.scale, K);
        PipeBarrier<PIPE_V>();
        Cast(idi, idf, RoundMode::CAST_RINT, K);
        if (bf16Out) {
            Cast(wbf, wf, RoundMode::CAST_RINT, K);
            PipeBarrier<PIPE_V>();
        }
        SetFlag<HardEvent::V_MTE3>(0);
        WaitFlag<HardEvent::V_MTE3>(0);
        DataCopyPad(IDS[(int64_t)row * K], idi, DataCopyExtParams{1, uint32_t(K * 4), 0, 0, 0});
        if (bf16Out) {
            DataCopyPad(W16[(int64_t)row * K], wbf, DataCopyExtParams{1, uint32_t(K * 2), 0, 0, 0});
        } else {
            DataCopyPad(W32[(int64_t)row * K], wf, DataCopyExtParams{1, uint32_t(K * 4), 0, 0, 0});
        }
        PipeBarrier<PIPE_ALL>();
    }
}

extern "C" void launch_router_topk(void* logits, void* bias, void* ids, void* weights, int rows, int experts,
                                   int k, float scale, int renormalize, int in_dtype, int out_dtype,
                                   void* stream) {
    TopkShape s{rows, experts, k, scale, renormalize, in_dtype, out_dtype};
    router_topk<<<48, nullptr, stream>>>((GM_ADDR)logits, (GM_ADDR)bias, (GM_ADDR)ids, (GM_ADDR)weights, s);
}
