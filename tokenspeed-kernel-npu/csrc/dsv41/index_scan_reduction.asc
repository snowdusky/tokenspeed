#include "kernel_operator.h"
using namespace AscendC;
constexpr int kSlots = 2;
constexpr int kSharedQueryPairs = 3;
constexpr int kSharedQueryRows = kSharedQueryPairs * 2;
__aicore__ inline int SMin(int a, int b) {
    return a < b ? a : b;
}
__aicore__ inline int SMax(int a, int b) {
    return a > b ? a : b;
}
constexpr IsResetLoad3dConfig kLoadConfig = {true, true};
// Decode bounded FP4 key tiles on Vector, then score them on Cube.
// Compatible query rows share one decoded tile without changing the BF16
// dot-product, weighted-product, or shard-reduction rounding boundaries.
struct IndexCodec {
    int64_t pageStride;
    TBuf<> rawBuf, halfBuf, indexBuf, pairBuf, valueBuf, scaleBuf, expandBuf, tableBuf;
    LocalTensor<uint8_t> raw;
    LocalTensor<half> halves;
    LocalTensor<uint32_t> offsets, pairs, fp4;
    LocalTensor<float> values, scales, expanded, e8;
    __aicore__ inline void Init(TPipe& p, GlobalTensor<uint32_t> tables, int64_t stride) {
        pageStride = stride;
        p.InitBuffer(rawBuf, 4352);
        p.InitBuffer(halfBuf, 8192 * 2);
        p.InitBuffer(indexBuf, 4096 * 4);
        p.InitBuffer(pairBuf, 4096 * 4);
        p.InitBuffer(valueBuf, 8192 * 4);
        p.InitBuffer(scaleBuf, 256 * 4);
        p.InitBuffer(expandBuf, 2048 * 4);
        p.InitBuffer(tableBuf, 512 * 4);
        raw = rawBuf.Get<uint8_t>();
        halves = halfBuf.Get<half>();
        offsets = indexBuf.Get<uint32_t>();
        pairs = pairBuf.Get<uint32_t>();
        values = valueBuf.Get<float>();
        scales = scaleBuf.Get<float>();
        expanded = expandBuf.Get<float>();
        fp4 = tableBuf.Get<uint32_t>();
        e8 = tableBuf.Get<float>()[256];
        DataCopy(fp4, tables, 512);
        SetFlag<HardEvent::MTE2_V>(3);
        WaitFlag<HardEvent::MTE2_V>(3);
    }
    __aicore__ inline void Page(GlobalTensor<uint8_t> cache, int page, GlobalTensor<bfloat16_t> dst) {
        DataCopy(raw, cache[(int64_t)page * pageStride], 4352);
        Decode(dst);
    }
    __aicore__ inline void BlockLoad(GlobalTensor<uint8_t> cache, int slot, int block) {
        int page = slot >= 0 ? slot / 64 : 0, offset = slot >= 0 ? slot % 64 : 0;
        DataCopy(raw[block * 512], cache[(int64_t)page * pageStride + offset * 64], 512);
        DataCopy(raw[4096 + block * 32], cache[(int64_t)page * pageStride + 4096 + offset * 4], 32);
    }
    __aicore__ inline void Decode(GlobalTensor<bfloat16_t> dst) {
        SetFlag<HardEvent::MTE2_V>(3);
        WaitFlag<HardEvent::MTE2_V>(3);
        Cast(halves, raw, RoundMode::CAST_NONE, 4096);
        PipeBarrier<PIPE_V>();
        Cast(offsets.ReinterpretCast<int32_t>(), halves, RoundMode::CAST_RINT, 4096);
        PipeBarrier<PIPE_V>();
        ShiftLeft(offsets, offsets, uint32_t(2), 4096);
        PipeBarrier<PIPE_V>();
        Gather(pairs, fp4, offsets, 0, 4096);
        PipeBarrier<PIPE_V>();
        Cast(values, pairs.ReinterpretCast<half>(), RoundMode::CAST_NONE, 8192);
        PipeBarrier<PIPE_V>();
        Cast(halves, raw[4096], RoundMode::CAST_NONE, 256);
        PipeBarrier<PIPE_V>();
        Cast(offsets.ReinterpretCast<int32_t>(), halves, RoundMode::CAST_RINT, 256);
        PipeBarrier<PIPE_V>();
        ShiftLeft(offsets, offsets, uint32_t(2), 256);
        PipeBarrier<PIPE_V>();
        Gather(scales, e8, offsets, 0, 256);
        PipeBarrier<PIPE_V>();
        Brcb(expanded, scales, 32, {1, 8});
        PipeBarrier<PIPE_V>();
        for (int half = 0; half < 2; ++half) {
            Mul(values[half * 4096], values[half * 4096], expanded[half * 1024], uint64_t(32), 128, {1, 1, 0, 4, 4, 1});
        }
        PipeBarrier<PIPE_V>();
        auto bf16 = halfBuf.Get<bfloat16_t>();
        Cast(bf16, values, RoundMode::CAST_RINT, 8192);
        PipeBarrier<PIPE_V>();
        SetFlag<HardEvent::V_MTE3>(3);
        WaitFlag<HardEvent::V_MTE3>(3);
        DataCopy(dst, bf16, 8192);
        SetFlag<HardEvent::MTE3_V>(3);
        WaitFlag<HardEvent::MTE3_V>(3);
        SetFlag<HardEvent::V_MTE2>(3);
        WaitFlag<HardEvent::V_MTE2>(3);
    }
};
struct ScanShape {
    int n, width, pages, parts, shards, table_width, sparse;
    int64_t cache_stride;
};

template <bool SPARSE>
__aicore__ inline int Logical(GlobalTensor<int32_t> candidates, ScanShape shape, int row, int col) {
    if (col >= shape.width) return -1;
    if (!SPARSE) return col;
    int block = candidates.GetValue((int64_t)row * (shape.width / 8) + col / 8);
    return block >= 0 && block < shape.table_width * 8 ? block * 8 + col % 8 : -1;
}
__aicore__ inline int Physical(GlobalTensor<int32_t> table, ScanShape shape, int row, int logical) {
    if (logical < 0 || logical >= shape.table_width * 64) return -1;
    int page = table.GetValue((int64_t)row * shape.table_width + logical / 64);
    return page >= 0 && page < shape.pages ? page * 64 + logical % 64 : -1;
}
template <bool SPARSE>
__aicore__ inline bool SameTile(GlobalTensor<int32_t> table, GlobalTensor<int32_t> candidates, ScanShape shape, int row,
                                int start) {
    if (row + 1 >= shape.n) return true;
    int step = SPARSE ? 8 : 64;
    for (int col = start; col < SMin(start + 128, shape.width); col += step) {
        if (Physical(table, shape, row, Logical<SPARSE>(candidates, shape, row, col)) !=
            Physical(table, shape, row + 1, Logical<SPARSE>(candidates, shape, row + 1, col)))
            return false;
    }
    return true;
}

template <bool SPARSE>
__aicore__ inline void ProduceIndexTile(IndexCodec& codec, GlobalTensor<uint8_t> k, GlobalTensor<bfloat16_t> decoded,
                                        GlobalTensor<int32_t> table, GlobalTensor<int32_t> candidates, ScanShape shape,
                                        int base, int row, int sub, int core, int start, int iteration) {
    // When both queries address the same keys, the two Vector cores
    // each decode half a tile into one shared mailbox.
    bool same = SameTile<SPARSE>(table, candidates, shape, base, start);
    int qr = SMin(row, shape.n - 1);
    int first = same ? sub * 64 : 0;
    int last = same ? first + 64 : 128;
    auto dst = decoded[(((int64_t)core * kSlots + iteration % kSlots) * 2 + (same ? 0 : sub)) * 128 * 128];
    for (int local = first; local < last;) {
        int col = start + local;
        int logical = Logical<SPARSE>(candidates, shape, qr, col);
        int slot = Physical(table, shape, qr, logical);
        bool whole_page = !SPARSE;
        if (SPARSE && logical >= 0 && logical % 64 == 0 && local + 64 <= last && col + 64 <= shape.width) {
            whole_page = true;
            for (int i = 1; i < 8; ++i) {
                if (Logical<SPARSE>(candidates, shape, qr, col + i * 8) != logical + i * 8) whole_page = false;
            }
        }
        if (whole_page) {
            codec.Page(k, slot >= 0 ? slot / 64 : 0, dst[local * 128]);
            local += 64;
        } else {
            for (int block = 0; block < 8; ++block) {
                int block_slot = Physical(table, shape, qr, Logical<SPARSE>(candidates, shape, qr, col + block * 8));
                codec.BlockLoad(k, block_slot, block);
            }
            codec.Decode(dst[local * 128]);
            local += 64;
        }
    }
}

template <int QUERY_PAIRS>
__aicore__ inline bool SameGroupTile(GlobalTensor<int32_t> table, ScanShape shape, int row, int start) {
    for (int col = start; col < SMin(start + 128, shape.width); col += 64) {
        int first = Physical(table, shape, row, col);
        for (int i = 1; i < 2 * QUERY_PAIRS; i++) {
            if (Physical(table, shape, row + i, col) != first) return false;
        }
    }
    return true;
}
template <int QUERY_PAIRS> __aicore__ inline int GroupExtent(GlobalTensor<int32_t> visible, ScanShape shape, int row) {
    int extent = 0;
    for (int i = 0; i < 2 * QUERY_PAIRS; i++) extent = SMax(extent, visible.GetValue(row + i));
    return SMin(SMax(extent, 0), shape.table_width * 64);
}
struct ScanPartition {
    int row, part, parts, pairs, extent;
};
template <int QUERY_PAIRS, bool SPARSE>
__aicore__ inline ScanPartition PartitionScan(GlobalTensor<int32_t> visible, GlobalTensor<int32_t> table,
                                              ScanShape shape, int job) {
    int row = (job / shape.parts) * (2 * QUERY_PAIRS), part = job % shape.parts;
    int parts = shape.parts, pairs = QUERY_PAIRS, extent;
    if constexpr (QUERY_PAIRS == 1) {
        int v0 = SMin(SMax(visible.GetValue(row), 0), shape.table_width * 64);
        int v1 = row + 1 < shape.n ? SMin(SMax(visible.GetValue(row + 1), 0), shape.table_width * 64) : 0;
        extent = SPARSE ? (SMax(v0, v1) > 0 ? shape.width : 0) : SMax(v0, v1);
    } else {
        extent = GroupExtent<QUERY_PAIRS>(visible, shape, row);
        if (parts % QUERY_PAIRS == 0 && (extent < 4096 || !SameGroupTile<QUERY_PAIRS>(table, shape, row, 0))) {
            // Short histories and distinct request pages retain independent
            // pair jobs. Later page differences are still checked per tile.
            row += (part % QUERY_PAIRS) * 2;
            part /= QUERY_PAIRS;
            parts /= QUERY_PAIRS;
            pairs = 1;
            extent = GroupExtent<1>(visible, shape, row);
        }
    }
    return {row, part, parts, pairs, extent};
}
template <int QUERY_PAIRS, bool SPARSE>
__aicore__ inline void ProduceGroup(IndexCodec& codec, GlobalTensor<uint8_t> k, GlobalTensor<bfloat16_t> decoded,
                                    GlobalTensor<int32_t> table, GlobalTensor<int32_t> candidates, ScanShape shape,
                                    int pairs, int base, int sub, int core, int start, int iteration) {
    bool shared = pairs > 1 && SameGroupTile<QUERY_PAIRS>(table, shape, base, start);
    for (int pair = 0; pair < (shared ? 1 : pairs); pair++) {
        int row = base + pair * 2;
        ProduceIndexTile<SPARSE>(codec, k, decoded, table, candidates, shape, row, row + sub, sub,
                                 core * QUERY_PAIRS + pair, start, iteration);
    }
    CrossCoreSetFlag<2, PIPE_MTE3>(4 + iteration % kSlots);
}
__aicore__ inline void LoadSingleQuery(GlobalTensor<bfloat16_t> q, LocalTensor<bfloat16_t> al1,
                                       LocalTensor<bfloat16_t> al0, int row) {
    Nd2NzParams a{};
    a.ndNum = 1;
    a.nValue = 32;
    a.dValue = 128;
    a.srcDValue = 128;
    a.dstNzC0Stride = 32;
    a.dstNzNStride = 1;
    DataCopy(al1, q[(int64_t)row * 32 * 128], a);
    SetFlag<HardEvent::MTE2_MTE1>(0);
    WaitFlag<HardEvent::MTE2_MTE1>(0);
    LoadData3DParamsV2<bfloat16_t> la{};
    la.l1H = 2;
    la.l1W = 16;
    la.channelSize = 128;
    la.padList[3] = 255;
    la.mExtension = 32;
    la.kExtension = 128;
    la.strideW = 1;
    la.strideH = 1;
    la.filterW = 1;
    la.filterH = 1;
    la.dilationFilterW = 1;
    la.dilationFilterH = 1;
    LoadData<kLoadConfig>(al0, al1, la);
    SetFlag<HardEvent::MTE1_M>(0);
    WaitFlag<HardEvent::MTE1_M>(0);
}
template <bool MULTISHARD, bool SPARSE, int QUERY_PAIRS>
__global__ __aicore__ void scan_mix(GM_ADDR qp, GM_ADDR wp, GM_ADDR kp, GM_ADDR tp, GM_ADDR vp, GM_ADDR op, GM_ADDR sp,
                                    GM_ADDR lookup, GM_ADDR cp, ScanShape shape) {
    static_assert(QUERY_PAIRS == 1 || QUERY_PAIRS == kSharedQueryPairs);
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    GlobalTensor<bfloat16_t> q, w;
    GlobalTensor<uint8_t> k;
    GlobalTensor<uint32_t> tables;
    GlobalTensor<int32_t> table, visible, candidates;
    GlobalTensor<float> output;
    GlobalTensor<bfloat16_t> scratch;
    q.SetGlobalBuffer((__gm__ bfloat16_t*)qp);
    w.SetGlobalBuffer((__gm__ bfloat16_t*)wp);
    k.SetGlobalBuffer((__gm__ uint8_t*)kp);
    tables.SetGlobalBuffer((__gm__ uint32_t*)lookup);
    table.SetGlobalBuffer((__gm__ int32_t*)tp);
    visible.SetGlobalBuffer((__gm__ int32_t*)vp);
    candidates.SetGlobalBuffer((__gm__ int32_t*)cp);
    output.SetGlobalBuffer((__gm__ float*)op);
    scratch.SetGlobalBuffer((__gm__ bfloat16_t*)sp);
    auto decoded = scratch[24 * kSlots * QUERY_PAIRS * 64 * 128];
    TPipe pipe;
    if ASCEND_IS_AIC {
        TBuf<TPosition::A1> aq;
        TBuf<TPosition::B1> bk;
        TBuf<TPosition::A2> a0;
        TBuf<TPosition::B2> b0;
        TBuf<TPosition::CO1> c0;
        pipe.InitBuffer(aq, (QUERY_PAIRS == 1 ? 128 : QUERY_PAIRS * 64 + 64) * 128 * 2);
        pipe.InitBuffer(bk, kSlots * 128 * 128 * 2);
        pipe.InitBuffer(a0, (QUERY_PAIRS == 1 ? 128 : QUERY_PAIRS * 64 + 64) * 128 * 2);
        pipe.InitBuffer(b0, kSlots * 128 * 128 * 2);
        pipe.InitBuffer(c0, kSlots * 64 * 128 * 4);

        int iteration = 0;
        const int core = GetBlockIdx();
        SetMMLayoutTransform(true);
        for (int job = core; job < ((shape.n + 2 * QUERY_PAIRS - 1) / (2 * QUERY_PAIRS)) * shape.parts; job += 24) {
            auto work = PartitionScan<QUERY_PAIRS, SPARSE>(visible, table, shape, job);
            int row = work.row, part = work.part;
            int extent = work.extent;
            int span = ((extent + work.parts * 128 - 1) / (work.parts * 128)) * 128;
            if (part * span >= extent) continue;
            // One-pair jobs retain combined and individual query layouts.
            // Grouped jobs retain each combined pair and reserve one extra
            // pair of slots for pages that diverge at replay time.
            for (int layout = 0; layout < (work.pairs == 1 ? 3 : work.pairs); layout++) {
                int m = work.pairs == 1 && layout != 0 ? 32 : 64;
                int offset =
                    work.pairs == 1 ? (layout == 0 ? 0 : 64 * 128 + (layout - 1) * 32 * 128) : layout * 64 * 128;
                auto al1 = aq.Get<bfloat16_t>()[offset];
                auto al0 = a0.Get<bfloat16_t>()[offset];
                for (int lane = 0; lane < (work.pairs == 1 && layout != 0 ? 1 : 2); lane++) {
                    int qr = SMin(row + (work.pairs == 1 ? (layout == 0 ? lane : layout - 1) : layout * 2 + lane),
                                  shape.n - 1);
                    Nd2NzParams a{};
                    a.ndNum = 1;
                    a.nValue = 32;
                    a.dValue = 128;
                    a.srcDValue = 128;
                    a.dstNzC0Stride = m;
                    a.dstNzNStride = 1;
                    DataCopy(al1[lane * 32 * 16], q[(int64_t)qr * 32 * 128], a);
                }
                SetFlag<HardEvent::MTE2_MTE1>(0);
                WaitFlag<HardEvent::MTE2_MTE1>(0);
                LoadData3DParamsV2<bfloat16_t> la{};
                la.l1H = m / 16;
                la.l1W = 16;
                la.channelSize = 128;
                la.padList[3] = 255;
                la.mExtension = m;
                la.kExtension = 128;
                la.strideW = 1;
                la.strideH = 1;
                la.filterW = 1;
                la.filterH = 1;
                la.dilationFilterW = 1;
                la.dilationFilterH = 1;
                LoadData<kLoadConfig>(al0, al1, la);
            }
            SetFlag<HardEvent::MTE1_M>(0);
            WaitFlag<HardEvent::MTE1_M>(0);
            for (int start = part * span; start < SMin((part + 1) * span, extent); start += 128) {
                CrossCoreWaitFlag(4 + iteration % kSlots);
                int bank = iteration % kSlots;
                auto bl1 = bk.Get<bfloat16_t>()[bank * 128 * 128];
                auto bl0 = b0.Get<bfloat16_t>()[bank * 128 * 128];
                auto cl0 = c0.Get<float>()[bank * 64 * 128];
                bool all_same = work.pairs > 1 && SameGroupTile<QUERY_PAIRS>(table, shape, row, start);
                for (int pair = 0; pair < work.pairs; pair++) {
                    bool same = all_same || SameTile<SPARSE>(table, candidates, shape, row + pair * 2, start);
                    for (int pass = 0; pass < (same ? 1 : 2); pass++) {
                        int m = same ? 64 : 32;
                        auto al0 =
                            a0.Get<bfloat16_t>()[same ? pair * 64 * 128
                                                      : ((work.pairs == 1 ? 64 : QUERY_PAIRS * 64) + pass * 32) * 128];
                        if (!same && work.pairs > 1)
                            LoadSingleQuery(
                                q, aq.Get<bfloat16_t>()[((work.pairs == 1 ? 64 : QUERY_PAIRS * 64) + pass * 32) * 128],
                                al0, row + pair * 2 + pass);
                        for (int page = 0; page < 2; page++) {
                            Nd2NzParams b{};
                            b.ndNum = 1;
                            b.nValue = 64;
                            b.dValue = 128;
                            b.srcDValue = 128;
                            b.dstNzC0Stride = 128;
                            b.dstNzNStride = 1;
                            DataCopy(
                                bl1[page * 64 * 16],
                                decoded[(((int64_t)(core * QUERY_PAIRS + (all_same ? 0 : pair)) * kSlots + bank) * 2 +
                                         pass) *
                                            128 * 128 +
                                        page * 64 * 128],
                                b);
                        }
                        SetFlag<HardEvent::MTE2_MTE1>(0);
                        WaitFlag<HardEvent::MTE2_MTE1>(0);
                        LoadData2DParams lb{};
                        lb.repeatTimes = 64;
                        lb.srcStride = 1;
                        LoadData(bl0, bl1, lb);
                        SetFlag<HardEvent::MTE1_M>(0);
                        WaitFlag<HardEvent::MTE1_M>(0);
                        MmadParams mm{};
                        mm.m = m;
                        mm.n = 128;
                        mm.k = 128;
                        mm.cmatrixInitVal = true;
                        mm.unitFlag = 0;
                        Mmad(cl0, al0, bl0, mm);
                        SetFlag<HardEvent::M_FIX>(0);
                        WaitFlag<HardEvent::M_FIX>(0);
                        DataCopyCO12DstParams fix{};
                        fix.mSize = m;
                        fix.nSize = 128;
                        fix.dstStride = 128;
                        fix.srcStride = m;
                        fix.nz2ndEn = true;
                        // Preserve the existing BF16 dot-product rounding at the
                        // producer, halving the Cube-to-Vector scratch traffic.
                        fix.quantPre = QuantMode_t::F322BF16;
                        fix.unitFlag = 0;
                        SetFixpipeNz2ndFlag(1, 1, 1);
                        DataCopy(
                            scratch[((int64_t)(core * QUERY_PAIRS + pair) * kSlots + iteration % kSlots) * 64 * 128 +
                                    pass * 32 * 128],
                            cl0, fix);
                        // Drain private L1/L0 owners before reuse; Cube/Vector overlap is
                        // carried by the two GM slots, not by unsafe buffer aliasing.
                        SetFlag<HardEvent::FIX_M>(1);
                        WaitFlag<HardEvent::FIX_M>(1);
                        SetFlag<HardEvent::M_MTE1>(1);
                        WaitFlag<HardEvent::M_MTE1>(1);
                        SetFlag<HardEvent::MTE1_MTE2>(1);
                        WaitFlag<HardEvent::MTE1_MTE2>(1);
                    }
                }
                CrossCoreSetFlag<2, PIPE_FIX>(2 + iteration % kSlots);
                iteration++;
            }
        }
        SetMMLayoutTransform(false);
    }
    if ASCEND_IS_AIV {
        int sub = GetBlockIdx() % 2, core = GetBlockIdx() / 2;
        TBuf<TPosition::VECCALC> data, half, weights, expanded_weights, acc, partial;
        pipe.InitBuffer(data, 32 * 128 * 4);
        pipe.InitBuffer(half, 32 * 128 * 2);
        pipe.InitBuffer(weights, 256);
        pipe.InitBuffer(expanded_weights, QUERY_PAIRS * 32 * 128 * 4);
        pipe.InitBuffer(acc, 128 * 4);
        pipe.InitBuffer(partial, (MULTISHARD ? 32 : 1) * 128 * 4);
        auto x = data.Get<float>();
        auto h = half.Get<bfloat16_t>();
        auto wt = weights.Get<float>();
        auto sum = acc.Get<float>();
        auto tmp = partial.Get<float>();
        auto broadcast_weights = expanded_weights.Get<float>();
        IndexCodec codec;
        codec.Init(pipe, tables, shape.cache_stride);
        const int shards = MULTISHARD ? shape.shards : 1;
        int iteration = 0;
        for (int job = core; job < ((shape.n + 2 * QUERY_PAIRS - 1) / (2 * QUERY_PAIRS)) * shape.parts; job += 24) {
            auto work = PartitionScan<QUERY_PAIRS, SPARSE>(visible, table, shape, job);
            int base = work.row, part = work.part;
            int extent = work.extent;
            int span = ((extent + work.parts * 128 - 1) / (work.parts * 128)) * 128;
            int limits[QUERY_PAIRS];
            for (int pair = 0; pair < work.pairs; pair++) {
                limits[pair] = visible.GetValue(SMin(base + pair * 2 + sub, shape.n - 1));
                DataCopy(wt[32].ReinterpretCast<bfloat16_t>(),
                         w[(int64_t)SMin(base + pair * 2 + sub, shape.n - 1) * 32], 32);
                SetFlag<HardEvent::MTE2_V>(0);
                WaitFlag<HardEvent::MTE2_V>(0);
                Cast(wt, wt[32].ReinterpretCast<bfloat16_t>(), RoundMode::CAST_NONE, 32);
                SetFlag<HardEvent::V_S>(0);
                WaitFlag<HardEvent::V_S>(0);
                // Weights are constant across historical tiles for this query. Expand
                // once per job, then issue one vector multiply instead of 32 scalars.
                for (int head = 0; head < 32; head++)
                    Duplicate(broadcast_weights[pair * 32 * 128 + head * 128], wt.GetValue(head), 128);
                PipeBarrier<PIPE_V>();
            }
            int end = SMin((part + 1) * span, extent);
            if (part * span < end) {
                ProduceGroup<QUERY_PAIRS, SPARSE>(codec, k, decoded, table, candidates, shape, work.pairs, base, sub,
                                                  core, part * span, iteration);
            }
            for (int start = part * span; start < end; start += 128) {
                // Prepare tile i+1 while Cube processes tile i. The two GM
                // banks are distinct; bank i is not republished until its old
                // score has been reduced by this AIV.
                if (start + 128 < end) {
                    ProduceGroup<QUERY_PAIRS, SPARSE>(codec, k, decoded, table, candidates, shape, work.pairs, base,
                                                      sub, core, start + 128, iteration + 1);
                }
                CrossCoreWaitFlag(2 + iteration % kSlots);
                for (int pair = 0; pair < work.pairs; pair++) {
                    int row = base + pair * 2 + sub;
                    DataCopy(h,
                             scratch[((int64_t)(core * QUERY_PAIRS + pair) * kSlots + iteration % kSlots) * 64 * 128 +
                                     sub * 32 * 128],
                             32 * 128);
                    SetFlag<HardEvent::MTE2_V>(0);
                    WaitFlag<HardEvent::MTE2_V>(0);
                    Cast(x, h, RoundMode::CAST_NONE, 32 * 128);
                    PipeBarrier<PIPE_V>();
                    Maxs(x, x, 0.f, 32 * 128);
                    PipeBarrier<PIPE_V>();
                    Mul(x, x, broadcast_weights[pair * 32 * 128], 32 * 128);
                    PipeBarrier<PIPE_V>();
                    Cast(h, x, RoundMode::CAST_RINT, 32 * 128);
                    PipeBarrier<PIPE_V>();
                    Cast(x, h, RoundMode::CAST_NONE, 32 * 128);
                    PipeBarrier<PIPE_V>();
                    Duplicate(sum, 0.f, 128);
                    PipeBarrier<PIPE_V>();
                    int heads = 32 / shards;
                    if constexpr (!MULTISHARD) {
                        for (int shard = 0; shard < shards; shard++) {
                            for (int stride = heads / 2; stride > 0; stride /= 2) {
                                // Adjacent heads are contiguous: one instruction keeps
                                // the same reduction tree without per-head issue cost.
                                Add(x[shard * heads * 128], x[shard * heads * 128], x[(shard * heads + stride) * 128],
                                    stride * 128);
                                PipeBarrier<PIPE_V>();
                            }
                            Cast(h, x[shard * heads * 128], RoundMode::CAST_RINT, 128);
                            PipeBarrier<PIPE_V>();
                            Cast(tmp, h, RoundMode::CAST_NONE, 128);
                            PipeBarrier<PIPE_V>();
                            Add(sum, sum, tmp, 128);
                            PipeBarrier<PIPE_V>();
                        }
                    } else {
                        // Independent shard trees share vector instructions. Preserve
                        // the reduction tree within each shard and its BF16 rounding.
                        for (int stride = heads / 2; stride > 0; stride /= 2) {
                            if (shards >= 4) {
                                const uint8_t repeatStride = heads * 16;
                                for (int offset = 0; offset < stride * 128; offset += 64) {
                                    Add(x[offset], x[offset], x[stride * 128 + offset], uint64_t(64), shards,
                                        {1, 1, 1, repeatStride, repeatStride, repeatStride});
                                }
                            } else {
                                for (int shard = 0; shard < shards; shard++) {
                                    Add(x[shard * heads * 128], x[shard * heads * 128],
                                        x[(shard * heads + stride) * 128], stride * 128);
                                }
                            }
                            PipeBarrier<PIPE_V>();
                        }
                        // Compact the first head of each shard before two batched
                        // casts. All source reductions are complete before this copy.
                        if (shards == 1) {
                            Cast(h, x, RoundMode::CAST_RINT, 128);
                        } else {
                            DataCopy(tmp, x, DataCopyParams{uint16_t(shards), 16, uint16_t((heads - 1) * 16), 0});
                            PipeBarrier<PIPE_V>();
                            Cast(h, tmp, RoundMode::CAST_RINT, shards * 128);
                        }
                        PipeBarrier<PIPE_V>();
                        Cast(tmp, h, RoundMode::CAST_NONE, shards * 128);
                        PipeBarrier<PIPE_V>();
                        for (int shard = 0; shard < shards; shard++) {
                            Add(sum, sum, tmp[shard * 128], 128);
                            PipeBarrier<PIPE_V>();
                        }
                    }
                    Cast(h, sum, RoundMode::CAST_RINT, 128);
                    PipeBarrier<PIPE_V>();
                    Cast(sum, h, RoundMode::CAST_NONE, 128);
                    PipeBarrier<PIPE_V>();
                    if (row < shape.n) {
                        int vis = limits[pair];
                        int step = SPARSE ? 8 : 64;
                        for (int local = 0; local < 128; local += step) {
                            int col = start + local;
                            if (col >= shape.width) continue;
                            int logical = Logical<SPARSE>(candidates, shape, row, col);
                            int slot = Physical(table, shape, row, logical);
                            int valid = slot >= 0 ? SMin(SMax(vis - logical, 0), step) : 0;
                            if (valid == 0) {
                                Duplicate(sum[local], -__builtin_inff(), step);
                                PipeBarrier<PIPE_V>();
                            } else if (valid < step) {
                                SetFlag<HardEvent::V_S>(1);
                                WaitFlag<HardEvent::V_S>(1);
                                for (int pos = valid; pos < step; pos++) sum.SetValue(local + pos, -__builtin_inff());
                                SetFlag<HardEvent::S_V>(1);
                                WaitFlag<HardEvent::S_V>(1);
                            }
                        }
                        SetFlag<HardEvent::V_MTE3>(0);
                        WaitFlag<HardEvent::V_MTE3>(0);
                        DataCopy(output[(int64_t)row * shape.width + start], sum, SMin(128, shape.width - start));
                        SetFlag<HardEvent::MTE3_V>(0);
                        WaitFlag<HardEvent::MTE3_V>(0);
                    }
                    // The next query pair reuses h/x; a Cube ready flag does
                    // not order this Vector core's private UB reads and writes.
                    SetFlag<HardEvent::V_MTE2>(2);
                    WaitFlag<HardEvent::V_MTE2>(2);
                }

                iteration++;
            }
        }
    }
}
extern "C" int launch_grouped_scan(void* q, void* w, void* k, void* table, void* visible, void* out, void* scratch,
                                   int n, int width, int pages, int parts, int shards, int table_width, int sparse,
                                   int query_pairs, int64_t cache_stride, void* lookup, void* candidates,
                                   void* stream) {
    if (parts < 1 || parts > 24) return 1;
    ScanShape shape{n, width, pages, parts, shards, table_width, sparse, cache_stride};
    if (query_pairs != 1 && query_pairs != kSharedQueryPairs) return 1;
    if (query_pairs == kSharedQueryPairs &&
        (sparse || shards != 1 || n < kSharedQueryRows || n % kSharedQueryRows != 0 || width < 4096))
        return 1;
    if (query_pairs == kSharedQueryPairs) {
        scan_mix<false, false, kSharedQueryPairs>
            <<<24, nullptr, stream>>>((GM_ADDR)q, (GM_ADDR)w, (GM_ADDR)k, (GM_ADDR)table, (GM_ADDR)visible,
                                      (GM_ADDR)out, (GM_ADDR)scratch, (GM_ADDR)lookup, (GM_ADDR)candidates, shape);
        return 0;
    }
    if (sparse) {
        if (shards == 1) {
            scan_mix<false, true, 1><<<24, nullptr, stream>>>((GM_ADDR)q, (GM_ADDR)w, (GM_ADDR)k, (GM_ADDR)table,
                                                              (GM_ADDR)visible, (GM_ADDR)out, (GM_ADDR)scratch,
                                                              (GM_ADDR)lookup, (GM_ADDR)candidates, shape);
        } else {
            scan_mix<true, true, 1><<<24, nullptr, stream>>>((GM_ADDR)q, (GM_ADDR)w, (GM_ADDR)k, (GM_ADDR)table,
                                                             (GM_ADDR)visible, (GM_ADDR)out, (GM_ADDR)scratch,
                                                             (GM_ADDR)lookup, (GM_ADDR)candidates, shape);
        }
    } else {
        if (shards == 1) {
            scan_mix<false, false, 1><<<24, nullptr, stream>>>((GM_ADDR)q, (GM_ADDR)w, (GM_ADDR)k, (GM_ADDR)table,
                                                               (GM_ADDR)visible, (GM_ADDR)out, (GM_ADDR)scratch,
                                                               (GM_ADDR)lookup, (GM_ADDR)candidates, shape);
        } else {
            scan_mix<true, false, 1><<<24, nullptr, stream>>>((GM_ADDR)q, (GM_ADDR)w, (GM_ADDR)k, (GM_ADDR)table,
                                                              (GM_ADDR)visible, (GM_ADDR)out, (GM_ADDR)scratch,
                                                              (GM_ADDR)lookup, (GM_ADDR)candidates, shape);
        }
    }
    return 0;
}
