#include "kernel_operator.h"
using namespace AscendC;

template <int B>
__global__ __aicore__ void shared_activation(GM_ADDR xp, GM_ADDR yp, int rows, int h, int stride, float limit,
                                             int cores) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    GlobalTensor<bfloat16_t> x, y;
    x.SetGlobalBuffer((__gm__ bfloat16_t*)xp);
    y.SetGlobalBuffer((__gm__ bfloat16_t*)yp);
    TPipe pipe;
    TBuf<> rawBuffer, gBuffer, uBuffer, tBuffer;
    pipe.InitBuffer(rawBuffer, 2 * B * 2);
    pipe.InitBuffer(gBuffer, B * 4);
    pipe.InitBuffer(uBuffer, B * 4);
    pipe.InitBuffer(tBuffer, B * 4);
    auto raw = rawBuffer.Get<bfloat16_t>();
    auto g = gBuffer.Get<float>(), u = uBuffer.Get<float>(), t = tBuffer.Get<float>();
    int chunks = (h + B - 1) / B;
    for (int task = GetBlockIdx(); task < rows * chunks; task += cores) {
        int row = task / chunks;
        int offset = (task % chunks) * B;
        int count = min(B, h - offset);
        DataCopyPad(raw, x[(int64_t)row * stride + offset],
                    DataCopyExtParams{2, uint32_t(count * 2), uint32_t((h - count) * 2),
                                      uint32_t((B - ((count + 15) / 16) * 16) / 16), 0},
                    DataCopyPadExtParams<bfloat16_t>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_V>(0);
        WaitFlag<HardEvent::MTE2_V>(0);
        Cast(g, raw, RoundMode::CAST_NONE, count);
        Cast(u, raw[B], RoundMode::CAST_NONE, count);
        PipeBarrier<PIPE_V>();
        if (limit > 0) {
            Mins(g, g, limit, count);
            Maxs(u, u, -limit, count);
            PipeBarrier<PIPE_V>();
            Mins(u, u, limit, count);
            PipeBarrier<PIPE_V>();
        }
        Muls(t, g, -1.f, count);
        PipeBarrier<PIPE_V>();
        Exp(t, t, count);
        PipeBarrier<PIPE_V>();
        Adds(t, t, 1.f, count);
        PipeBarrier<PIPE_V>();
        Div(t, g, t, count);
        PipeBarrier<PIPE_V>();
        Mul(t, t, u, count);
        PipeBarrier<PIPE_V>();
        Cast(raw, t, RoundMode::CAST_RINT, count);
        SetFlag<HardEvent::V_MTE3>(0);
        WaitFlag<HardEvent::V_MTE3>(0);
        DataCopyPad(y[(int64_t)row * h + offset], raw, DataCopyExtParams{1, uint32_t(count * 2), 0, 0, 0});
        SetFlag<HardEvent::MTE3_MTE2>(0);
        WaitFlag<HardEvent::MTE3_MTE2>(0);
    }
}
extern "C" void launch_shared_activation(void* x, void* y, int rows, int h, int stride, float limit, void* stream) {
    int tasks = rows * ((h + 4095) / 4096);
    int cores = tasks < 48 ? tasks : 48;
    if (h <= 512)
        shared_activation<512><<<cores, nullptr, stream>>>((GM_ADDR)x, (GM_ADDR)y, rows, h, stride, limit, cores);
    else if (h <= 1024)
        shared_activation<1024><<<cores, nullptr, stream>>>((GM_ADDR)x, (GM_ADDR)y, rows, h, stride, limit, cores);
    else
        shared_activation<4096><<<cores, nullptr, stream>>>((GM_ADDR)x, (GM_ADDR)y, rows, h, stride, limit, cores);
}
