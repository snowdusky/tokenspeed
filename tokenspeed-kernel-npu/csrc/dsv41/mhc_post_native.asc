#include "kernel_operator.h"
using namespace AscendC;

struct PostShape {
    int rows, hidden;
};

template <int B>
__global__ __aicore__ void mhc_post_native(GM_ADDR xp, GM_ADDR rp, GM_ADDR pp, GM_ADDR cp, GM_ADDR yp, PostShape s) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    GlobalTensor<bfloat16_t> x, residual, out;
    GlobalTensor<float> post, comb;
    x.SetGlobalBuffer((__gm__ bfloat16_t*)xp);
    residual.SetGlobalBuffer((__gm__ bfloat16_t*)rp);
    out.SetGlobalBuffer((__gm__ bfloat16_t*)yp);
    post.SetGlobalBuffer((__gm__ float*)pp);
    comb.SetGlobalBuffer((__gm__ float*)cp);
    TBuf<TPosition::VECCALC> raw_buf, fp_buf, acc_buf, tmp_buf, out_buf, coeff_buf;
    pipe.InitBuffer(raw_buf, 5 * B * 2);
    pipe.InitBuffer(fp_buf, 5 * B * 4);
    pipe.InitBuffer(acc_buf, 4 * B * 4);
    pipe.InitBuffer(tmp_buf, 4 * B * 4);
    pipe.InitBuffer(out_buf, 4 * B * 2);
    pipe.InitBuffer(coeff_buf, 96);
    auto raw = raw_buf.Get<bfloat16_t>();
    auto fp = fp_buf.Get<float>();
    auto acc = acc_buf.Get<float>();
    auto tmp = tmp_buf.Get<float>();
    auto result = out_buf.Get<bfloat16_t>();
    auto coeff = coeff_buf.Get<float>();
    const int blocks = (s.hidden + B - 1) / B;
    for (int job = GetBlockIdx(); job < s.rows * blocks; job += GetBlockNum()) {
        const int row = job / blocks, col = (job % blocks) * B;
        const int width = s.hidden - col < B ? s.hidden - col : B;
        const int64_t residual_offset = (int64_t)row * 4 * s.hidden + col;
        DataCopyPad(raw, residual[residual_offset],
                    DataCopyExtParams{4, (uint32_t)width * 2, (uint32_t)(s.hidden - width) * 2,
                                      (uint32_t)(B - width) * 2 / 32, 0},
                    DataCopyPadExtParams<bfloat16_t>{false, 0, 0, 0});
        DataCopyPad(raw[4 * B], x[(int64_t)row * s.hidden + col], DataCopyExtParams{1, (uint32_t)width * 2, 0, 0, 0},
                    DataCopyPadExtParams<bfloat16_t>{false, 0, 0, 0});
        DataCopy(coeff, comb[(int64_t)row * 16], 16);
        DataCopyPad(coeff[16], post[(int64_t)row * 4], DataCopyExtParams{1, 16, 0, 0, 0},
                    DataCopyPadExtParams<float>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_V>(0);
        WaitFlag<HardEvent::MTE2_V>(0);
        SetFlag<HardEvent::MTE2_S>(0);
        WaitFlag<HardEvent::MTE2_S>(0);
        Cast(fp, raw, RoundMode::CAST_NONE, 5 * B);
        PipeBarrier<PIPE_V>();
        for (int o = 0; o < 4; ++o) Muls(acc[o * B], fp[4 * B], coeff.GetValue(16 + o), width);
        PipeBarrier<PIPE_V>();
        // Match the existing FP32 accumulation order: post*x, then streams 0..3.
        for (int i = 0; i < 4; ++i) {
            for (int o = 0; o < 4; ++o) Muls(tmp[o * B], fp[i * B], coeff.GetValue(i * 4 + o), width);
            PipeBarrier<PIPE_V>();
            Add(acc, acc, tmp, 4 * B);
            PipeBarrier<PIPE_V>();
        }
        Cast(result, acc, RoundMode::CAST_RINT, 4 * B);
        SetFlag<HardEvent::V_MTE3>(0);
        WaitFlag<HardEvent::V_MTE3>(0);
        DataCopyPad(out[residual_offset], result,
                    DataCopyExtParams{4, (uint32_t)width * 2, (uint32_t)(B - width) * 2 / 32,
                                      (uint32_t)(s.hidden - width) * 2, 0});
        SetFlag<HardEvent::MTE3_MTE2>(0);
        WaitFlag<HardEvent::MTE3_MTE2>(0);
        SetFlag<HardEvent::MTE3_V>(0);
        WaitFlag<HardEvent::MTE3_V>(0);
    }
}

extern "C" void launch_mhc_post(void* x, void* r, void* p, void* c, void* y, int rows, int hidden, int block,
                                void* stream) {
    PostShape s{rows, hidden};
    if (block == 512)
        mhc_post_native<512><<<48, nullptr, stream>>>((GM_ADDR)x, (GM_ADDR)r, (GM_ADDR)p, (GM_ADDR)c, (GM_ADDR)y, s);
    else if (block == 1024)
        mhc_post_native<1024><<<48, nullptr, stream>>>((GM_ADDR)x, (GM_ADDR)r, (GM_ADDR)p, (GM_ADDR)c, (GM_ADDR)y, s);
    else
        mhc_post_native<2048><<<48, nullptr, stream>>>((GM_ADDR)x, (GM_ADDR)r, (GM_ADDR)p, (GM_ADDR)c, (GM_ADDR)y, s);
}
