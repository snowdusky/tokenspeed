#include "kernel_operator.h"
using namespace AscendC;

struct TableShape {
    int rows, requests, width, ratio;
    int64_t position_stride, request_stride, table_stride;
};

template <typename P, typename R, typename T>
__global__ __aicore__ void index_selection_table(GM_ADDR pp, GM_ADDR rp, GM_ADDR tp, GM_ADDR op, GM_ADDR lp,
                                                 TableShape s) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    constexpr int B = 256;
    GlobalTensor<P> positions;
    GlobalTensor<R> requests;
    GlobalTensor<T> table;
    GlobalTensor<int32_t> output, lengths;
    positions.SetGlobalBuffer((__gm__ P*)pp);
    requests.SetGlobalBuffer((__gm__ R*)rp);
    table.SetGlobalBuffer((__gm__ T*)tp);
    output.SetGlobalBuffer((__gm__ int32_t*)op);
    lengths.SetGlobalBuffer((__gm__ int32_t*)lp);
    TPipe pipe;
    TBuf<> source_buffer, result_buffer, length_buffer;
    pipe.InitBuffer(source_buffer, B * sizeof(T));
    pipe.InitBuffer(result_buffer, B * 4);
    pipe.InitBuffer(length_buffer, 32);
    auto length = length_buffer.Get<int32_t>();
    auto source = source_buffer.Get<T>();
    auto result = result_buffer.Get<int32_t>();
    int tiles = (s.width + B - 1) / B;
    if (tiles == 0) tiles = 1;
    for (int job = GetBlockIdx(); job < s.rows * tiles; job += GetBlockNum()) {
        int row = job / tiles, col = (job % tiles) * B;
        int count = s.width - col;
        count = count < B ? count : B;
        int64_t request = requests.GetValue((int64_t)row * s.request_stride);
        if (col == 0) {
            int64_t position = positions.GetValue((int64_t)row * s.position_stride);
            int64_t visible = position >= 0 ? (position + 1) / s.ratio : 0;
            length.SetValue(0, (int32_t)visible);
            SetFlag<HardEvent::S_MTE3>(1);
            WaitFlag<HardEvent::S_MTE3>(1);
            DataCopyPad(lengths[row], length, DataCopyExtParams{1, 4, 0, 0, 0});
            SetFlag<HardEvent::MTE3_S>(1);
            WaitFlag<HardEvent::MTE3_S>(1);
        }
        if (count <= 0) continue;
        if (request >= 0 && request < s.requests) {
            DataCopyPad(source, table[request * s.table_stride + col],
                        DataCopyExtParams{1, uint32_t(count * sizeof(T)), 0, 0, 0},
                        DataCopyPadExtParams<T>{false, 0, 0, 0});
            SetFlag<HardEvent::MTE2_V>(0);
            WaitFlag<HardEvent::MTE2_V>(0);
            // Page IDs are INT32 by the cache contract, even with INT64 metadata.
            if constexpr (sizeof(T) == 8)
                Cast(result, source, RoundMode::CAST_NONE, B);
            else
                DataCopy(result, source, B);
            PipeBarrier<PIPE_V>();
            Maxs(result, result, int32_t(0), B);
            PipeBarrier<PIPE_V>();
            // Turn null page zero into -1 without changing positive page IDs.
        } else {
            Duplicate(result, int32_t(0), B);
        }
        PipeBarrier<PIPE_V>();
        // min(page,1)-1 is -1 for null pages and zero for positive pages.
        auto flags = source_buffer.Get<int32_t>();
        Mins(flags, result, int32_t(1), B);
        PipeBarrier<PIPE_V>();
        Adds(flags, flags, int32_t(-1), B);
        PipeBarrier<PIPE_V>();
        Add(result, result, flags, B);
        SetFlag<HardEvent::V_MTE3>(0);
        WaitFlag<HardEvent::V_MTE3>(0);
        DataCopyPad(output[(int64_t)row * s.width + col], result, DataCopyExtParams{1, uint32_t(count * 4), 0, 0, 0});
        SetFlag<HardEvent::MTE3_V>(0);
        WaitFlag<HardEvent::MTE3_V>(0);
        SetFlag<HardEvent::V_MTE2>(0);
        WaitFlag<HardEvent::V_MTE2>(0);
    }
}

struct PrepareShape {
    int rows, count, candidates;
    int64_t vs, is, cs, ls;
};
__global__ __aicore__ void index_selection_prepare(GM_ADDR vp, GM_ADDR ip, GM_ADDR cp, GM_ADDR op, GM_ADDR lp,
                                                   PrepareShape s) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    constexpr int B = 2048;
    GlobalTensor<float> values, output;
    GlobalTensor<int64_t> indices;
    GlobalTensor<int32_t> candidates, lengths;
    values.SetGlobalBuffer((__gm__ float*)vp);
    indices.SetGlobalBuffer((__gm__ int64_t*)ip);
    candidates.SetGlobalBuffer((__gm__ int32_t*)cp);
    output.SetGlobalBuffer((__gm__ float*)op);
    lengths.SetGlobalBuffer((__gm__ int32_t*)lp);
    TPipe pipe;
    TBuf<> vb, ib, xb, cb, mb, fb, tb, wb;
    pipe.InitBuffer(vb, B * 4);
    pipe.InitBuffer(ib, B * 8);
    pipe.InitBuffer(xb, B * 4);
    pipe.InitBuffer(cb, B * 4);
    pipe.InitBuffer(mb, B / 8);
    pipe.InitBuffer(fb, B * 4);
    pipe.InitBuffer(tb, B * 4);
    pipe.InitBuffer(wb, B * 4);
    auto v = vb.Get<float>();
    auto ids64 = ib.Get<int64_t>();
    auto ids = xb.Get<int32_t>();
    auto pool = cb.Get<int32_t>();
    auto mask = mb.Get<uint8_t>();
    auto f = fb.Get<float>();
    auto tmp = tb.Get<int32_t>();
    auto work = wb.Get<float>();
    int size = ((s.count + 63) / 64) * 64;
    const float inf = __builtin_inff();
    for (int row = GetBlockIdx(); row < s.rows; row += GetBlockNum()) {
        Duplicate(v, -inf, size);
        SetFlag<HardEvent::V_MTE2>(0);
        WaitFlag<HardEvent::V_MTE2>(0);
        DataCopyPad(v, values[(int64_t)row * s.vs], DataCopyExtParams{1, uint32_t(s.count * 4), 0, 0, 0},
                    DataCopyPadExtParams<float>{true, 0, uint8_t((8 - s.count % 8) % 8), -inf});
        DataCopyPad(ids64, indices[(int64_t)row * s.is], DataCopyExtParams{1, uint32_t(s.count * 8), 0, 0, 0},
                    DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
        if (s.candidates)
            DataCopyPad(pool, candidates[(int64_t)row * s.cs],
                        DataCopyExtParams{1, uint32_t(s.candidates * 4), 0, 0, 0},
                        DataCopyPadExtParams<int32_t>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_V>(0);
        WaitFlag<HardEvent::MTE2_V>(0);
        CompareScalar(mask, v, -inf, CMPMODE::GT, size);
        PipeBarrier<PIPE_V>();
        Cast(ids, ids64, RoundMode::CAST_NONE, size);
        PipeBarrier<PIPE_V>();
        if (s.candidates) {
            // TopK indices address the bounded candidate-score row.
            Mins(ids, ids, int32_t(s.candidates * 8 - 1), size);
            PipeBarrier<PIPE_V>();
            Maxs(ids, ids, int32_t(0), size);
            PipeBarrier<PIPE_V>();
            auto offsets = tmp.ReinterpretCast<uint32_t>();
            ShiftRight(offsets, ids.ReinterpretCast<uint32_t>(), uint32_t(3), size);
            PipeBarrier<PIPE_V>();
            ShiftLeft(offsets, offsets, uint32_t(2), size);
            PipeBarrier<PIPE_V>();
            Gather(v.ReinterpretCast<int32_t>(), pool, offsets, 0, size);
            PipeBarrier<PIPE_V>();
            // Preserve the lane within the selected eight-token candidate block.
            ShiftRight(offsets, ids.ReinterpretCast<uint32_t>(), uint32_t(3), size);
            PipeBarrier<PIPE_V>();
            ShiftLeft(offsets, offsets, uint32_t(3), size);
            PipeBarrier<PIPE_V>();
            Sub(ids, ids, tmp, size);
            PipeBarrier<PIPE_V>();
            ShiftLeft(v.ReinterpretCast<uint32_t>(), v.ReinterpretCast<uint32_t>(), uint32_t(3), size);
            PipeBarrier<PIPE_V>();
            Add(ids, ids, v.ReinterpretCast<int32_t>(), size);
            PipeBarrier<PIPE_V>();
        }
        Cast(f, ids, RoundMode::CAST_NONE, size);
        PipeBarrier<PIPE_V>();
        Duplicate(v, inf, size);
        PipeBarrier<PIPE_V>();
        Select(f, mask, f, v, SELMODE::VSEL_TENSOR_TENSOR_MODE, size);
        PipeBarrier<PIPE_V>();
        Duplicate(v, 1.f, size);
        Duplicate(work, 0.f, size);
        PipeBarrier<PIPE_V>();
        Select(v, mask, v, work, SELMODE::VSEL_TENSOR_TENSOR_MODE, size);
        PipeBarrier<PIPE_V>();
        ReduceSum(work, v, tmp.ReinterpretCast<float>(), size);
        SetFlag<HardEvent::V_S>(0);
        WaitFlag<HardEvent::V_S>(0);
        tmp.SetValue(0, (int32_t)work.GetValue(0));
        SetFlag<HardEvent::S_MTE3>(1);
        WaitFlag<HardEvent::S_MTE3>(1);
        DataCopyPad(lengths[(int64_t)row * s.ls], tmp, DataCopyExtParams{1, 4, 0, 0, 0});
        SetFlag<HardEvent::MTE3_V>(1);
        WaitFlag<HardEvent::MTE3_V>(1);
        SetFlag<HardEvent::V_MTE3>(0);
        WaitFlag<HardEvent::V_MTE3>(0);
        DataCopyPad(output[(int64_t)row * s.count], f, DataCopyExtParams{1, uint32_t(s.count * 4), 0, 0, 0});
        SetFlag<HardEvent::MTE3_V>(0);
        WaitFlag<HardEvent::MTE3_V>(0);
        SetFlag<HardEvent::MTE3_MTE2>(0);
        WaitFlag<HardEvent::MTE3_MTE2>(0);
    }
}

extern "C" void launch_table(void** p, int rows, int requests, int width, int ratio, int types, int64_t ps, int64_t rs,
                             int64_t ts, void* stream) {
    TableShape s{rows, requests, width, ratio, ps, rs, ts};
#define TABLE(P, R, T)             \
    index_selection_table<P, R, T> \
        <<<48, nullptr, stream>>>((GM_ADDR)p[0], (GM_ADDR)p[1], (GM_ADDR)p[2], (GM_ADDR)p[3], (GM_ADDR)p[4], s)
    switch (types) {
        case 0:
            TABLE(int32_t, int32_t, int32_t);
            break;
        case 1:
            TABLE(int64_t, int32_t, int32_t);
            break;
        case 2:
            TABLE(int32_t, int64_t, int32_t);
            break;
        case 3:
            TABLE(int64_t, int64_t, int32_t);
            break;
        case 4:
            TABLE(int32_t, int32_t, int64_t);
            break;
        case 5:
            TABLE(int64_t, int32_t, int64_t);
            break;
        case 6:
            TABLE(int32_t, int64_t, int64_t);
            break;
        case 7:
            TABLE(int64_t, int64_t, int64_t);
            break;
    }
}
extern "C" void launch_prepare(void** p, int rows, int count, int candidates, int64_t vs, int64_t is, int64_t cs,
                               int64_t ls, void* stream) {
    PrepareShape s{rows, count, candidates, vs, is, cs, ls};
    index_selection_prepare<<<48, nullptr, stream>>>((GM_ADDR)p[0], (GM_ADDR)p[1], (GM_ADDR)p[2], (GM_ADDR)p[3],
                                                     (GM_ADDR)p[4], s);
}
