#include "kernel_operator.h"
using namespace AscendC;

extern "C" __global__ __aicore__ void mapped_fp8_fused(GM_ADDR wp, GM_ADDR sp, GM_ADDR ip, GM_ADDR op, GM_ADDR lp,
                                                       int rows, int64_t start, int64_t end) {
    if ASCEND_IS_AIV {
        TPipe pipe;
        TBuf<> rawBuf, halfBuf, indexBuf, valueBuf, scaleBuf, expandedBuf, tableBuf;
        pipe.InitBuffer(rawBuf, 288);
        pipe.InitBuffer(halfBuf, 512);
        pipe.InitBuffer(indexBuf, 1024);
        pipe.InitBuffer(valueBuf, 1024);
        pipe.InitBuffer(scaleBuf, 128);
        pipe.InitBuffer(expandedBuf, 256);
        pipe.InitBuffer(tableBuf, 2048);
        auto raw = rawBuf.Get<uint8_t>();
        auto halves = halfBuf.Get<half>();
        auto index = indexBuf.Get<int32_t>();
        auto value = valueBuf.Get<float>();
        auto scale = scaleBuf.Get<float>();
        auto expanded = expandedBuf.Get<float>();
        auto tables = tableBuf.Get<float>();
        auto result = halfBuf.Get<bfloat16_t>();
        GlobalTensor<uint8_t> weight, scales;
        GlobalTensor<int64_t> ids;
        GlobalTensor<bfloat16_t> output;
        GlobalTensor<float> lut;
        weight.SetGlobalBuffer((__gm__ uint8_t*)wp);
        scales.SetGlobalBuffer((__gm__ uint8_t*)sp);
        ids.SetGlobalBuffer((__gm__ int64_t*)ip);
        output.SetGlobalBuffer((__gm__ bfloat16_t*)op);
        lut.SetGlobalBuffer((__gm__ float*)lp);
        DataCopy(tables, lut, 512);
        SetFlag<HardEvent::MTE2_V>(0);
        WaitFlag<HardEvent::MTE2_V>(0);
        for (int row = GetBlockIdx(); row < rows; row += GetBlockNum()) {
            int64_t id = ids.GetValue(row);
            if (id >= start && id < end) {
                id -= start;
                DataCopy(raw, weight[id * 256], 256);
                DataCopyPad(raw[256], scales[id * 8], DataCopyExtParams{1, 8, 0, 0, 0},
                            DataCopyPadExtParams<uint8_t>{true, 0, 24, 127});
                SetFlag<HardEvent::MTE2_V>(0);
                WaitFlag<HardEvent::MTE2_V>(0);
                Cast(halves, raw, RoundMode::CAST_NONE, 256);
                PipeBarrier<PIPE_V>();
                Cast(index, halves, RoundMode::CAST_RINT, 256);
                PipeBarrier<PIPE_V>();
                ShiftLeft(index.ReinterpretCast<uint32_t>(), index.ReinterpretCast<uint32_t>(), uint32_t(2), 256);
                PipeBarrier<PIPE_V>();
                Gather(value, tables, index.ReinterpretCast<uint32_t>(), 0, 256);
                PipeBarrier<PIPE_V>();
                Cast(halves, raw[256], RoundMode::CAST_NONE, 32);
                PipeBarrier<PIPE_V>();
                Cast(index, halves, RoundMode::CAST_RINT, 32);
                PipeBarrier<PIPE_V>();
                ShiftLeft(index.ReinterpretCast<uint32_t>(), index.ReinterpretCast<uint32_t>(), uint32_t(2), 32);
                PipeBarrier<PIPE_V>();
                Gather(scale, tables[256], index.ReinterpretCast<uint32_t>(), 0, 32);
                PipeBarrier<PIPE_V>();
                Brcb(expanded, scale, 1, {1, 8});
                PipeBarrier<PIPE_V>();
                Mul(value, value, expanded, uint64_t(32), 8, {1, 1, 0, 4, 4, 1});
                PipeBarrier<PIPE_V>();
                Cast(result, value, RoundMode::CAST_RINT, 256);
                PipeBarrier<PIPE_V>();
            } else {
                Duplicate(result.ReinterpretCast<uint16_t>(), uint16_t(0), 256);
                PipeBarrier<PIPE_V>();
            }
            SetFlag<HardEvent::V_MTE3>(0);
            WaitFlag<HardEvent::V_MTE3>(0);
            DataCopy(output[(int64_t)row * 256], result, 256);
            SetFlag<HardEvent::MTE3_V>(0);
            WaitFlag<HardEvent::MTE3_V>(0);
            SetFlag<HardEvent::V_MTE2>(0);
            WaitFlag<HardEvent::V_MTE2>(0);
        }
    }
}
extern "C" void launch_fp8_fused(void* w, void* s, void* ids, void* out, void* lut, int rows, int64_t start,
                                 int64_t end, void* stream) {
    mapped_fp8_fused<<<48, nullptr, stream>>>((GM_ADDR)w, (GM_ADDR)s, (GM_ADDR)ids, (GM_ADDR)out, (GM_ADDR)lut, rows,
                                              start, end);
}
