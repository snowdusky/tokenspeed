#include "kernel_operator.h"
using namespace AscendC;
struct SlotShape {
    int rows, width, table_rows, table_cols, ratio, pages;
    int64_t row_stride, pos_stride, req_stride, table_stride;
};
template <typename P, typename R>
__global__ __aicore__ void selected_global_slots(GM_ADDR rp, GM_ADDR pp, GM_ADDR qp, GM_ADDR tp, GM_ADDR op,
                                                 SlotShape s) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    constexpr int B = 256;
    TPipe pipe;
    GlobalTensor<int32_t> rows, table, out;
    GlobalTensor<P> pos;
    GlobalTensor<R> req;
    rows.SetGlobalBuffer((__gm__ int32_t*)rp);
    table.SetGlobalBuffer((__gm__ int32_t*)tp);
    out.SetGlobalBuffer((__gm__ int32_t*)op);
    pos.SetGlobalBuffer((__gm__ P*)pp);
    req.SetGlobalBuffer((__gm__ R*)qp);
    TBuf<TPosition::VECCALC> rb, tb, cb, pb, ob, nb, mb, mb2, ib, fb;
    pipe.InitBuffer(fb, B * 4);
    pipe.InitBuffer(rb, B * 4);
    pipe.InitBuffer(tb, ((s.table_cols + 7) / 8) * 32);
    pipe.InitBuffer(cb, B * 4);
    pipe.InitBuffer(pb, B * 4);
    pipe.InitBuffer(ob, B * 4);
    pipe.InitBuffer(nb, B * 4);
    pipe.InitBuffer(mb, 32);
    pipe.InitBuffer(mb2, 32);
    pipe.InitBuffer(ib, B * 4);
    auto values = fb.Get<float>();
    auto selected = rb.Get<int32_t>();
    auto local_table = tb.Get<int32_t>();
    auto column = cb.Get<int32_t>();
    auto page = pb.Get<int32_t>();
    auto result = ob.Get<int32_t>();
    auto negative = nb.Get<int32_t>();
    auto mask = mb.Get<uint8_t>();
    auto test = mb2.Get<uint8_t>();
    auto low = ib.Get<int32_t>();
    Duplicate(negative, (int32_t)-1, B);
    const int chunks = (s.width + B - 1) / B;
    for (int job = GetBlockIdx(); job < s.rows * chunks; job += GetBlockNum()) {
        int row = job / chunks, start = (job % chunks) * B, count = s.width - start;
        if (count > B) count = B;
        int64_t request = req.GetValue((int64_t)row * s.req_stride),
                position = pos.GetValue((int64_t)row * s.pos_stride);
        int limit = position < 0                                           ? 0
                    : position >= (int64_t)s.table_cols * 64 * s.ratio - 1 ? s.table_cols * 64
                                                                           : (position + 1) / s.ratio;
        if (request < 0 || request >= s.table_rows || limit <= 0 || s.pages <= 1) {
            SetFlag<HardEvent::V_MTE3>(0);
            WaitFlag<HardEvent::V_MTE3>(0);
            DataCopyPad(out[(int64_t)row * s.width + start], negative,
                        DataCopyExtParams{1, (uint32_t)count * 4, 0, 0, 0});
        } else {
            DataCopyPad(selected, rows[(int64_t)row * s.row_stride + start],
                        DataCopyExtParams{1, (uint32_t)count * 4, 0, 0, 0},
                        DataCopyPadExtParams<int32_t>{false, 0, 0, 0});
            DataCopyPad(local_table, table[request * s.table_stride],
                        DataCopyExtParams{1, (uint32_t)s.table_cols * 4, 0, 0, 0},
                        DataCopyPadExtParams<int32_t>{false, 0, 0, 0});
            SetFlag<HardEvent::MTE2_V>(0);
            WaitFlag<HardEvent::MTE2_V>(0);
            // 910 compares floats; valid logical/page ranges are exact in FP32.
            // Slot arithmetic and gather remain int32.
            Cast(values, selected, RoundMode::CAST_NONE, B);
            PipeBarrier<PIPE_V>();
            CompareScalar(mask, values, 0.0f, CMPMODE::GE, B);
            CompareScalar(test, values, (float)limit, CMPMODE::LT, B);
            Maxs(column, selected, (int32_t)0, B);
            PipeBarrier<PIPE_V>();
            And(mask.ReinterpretCast<uint16_t>(), mask.ReinterpretCast<uint16_t>(), test.ReinterpretCast<uint16_t>(),
                16);
            Mins(column, column, (int32_t)(s.table_cols * 64 - 1), B);
            PipeBarrier<PIPE_V>();
            ShiftRight(column, column, (int32_t)6, B);
            PipeBarrier<PIPE_V>();
            ShiftLeft(column, column, (int32_t)2, B);
            PipeBarrier<PIPE_V>();
            Gather(page, local_table, column.ReinterpretCast<uint32_t>(), (uint32_t)0, B);
            PipeBarrier<PIPE_V>();
            Cast(values, page, RoundMode::CAST_NONE, B);
            PipeBarrier<PIPE_V>();
            CompareScalar(test, values, 1.0f, CMPMODE::GE, B);
            PipeBarrier<PIPE_V>();
            And(mask.ReinterpretCast<uint16_t>(), mask.ReinterpretCast<uint16_t>(), test.ReinterpretCast<uint16_t>(),
                16);
            PipeBarrier<PIPE_V>();
            CompareScalar(test, values, (float)s.pages, CMPMODE::LT, B);
            PipeBarrier<PIPE_V>();
            And(mask.ReinterpretCast<uint16_t>(), mask.ReinterpretCast<uint16_t>(), test.ReinterpretCast<uint16_t>(),
                16);
            ShiftLeft(low, selected, (int32_t)26, B);
            PipeBarrier<PIPE_V>();
            ShiftRight(low.ReinterpretCast<uint32_t>(), low.ReinterpretCast<uint32_t>(), (uint32_t)26, B);
            ShiftLeft(result, page, (int32_t)6, B);
            PipeBarrier<PIPE_V>();
            Add(result, result, low, B);
            PipeBarrier<PIPE_V>();
            Select(result.ReinterpretCast<float>(), mask, result.ReinterpretCast<float>(),
                   negative.ReinterpretCast<float>(), SELMODE::VSEL_TENSOR_TENSOR_MODE, B);
            SetFlag<HardEvent::V_MTE3>(0);
            WaitFlag<HardEvent::V_MTE3>(0);
            DataCopyPad(out[(int64_t)row * s.width + start], result,
                        DataCopyExtParams{1, (uint32_t)count * 4, 0, 0, 0});
        }
        SetFlag<HardEvent::MTE3_MTE2>(0);
        WaitFlag<HardEvent::MTE3_MTE2>(0);
        SetFlag<HardEvent::MTE3_V>(0);
        WaitFlag<HardEvent::MTE3_V>(0);
    }
}
extern "C" void launch_global_slots(void* r, void* p, void* q, void* t, void* o, int rows, int width, int tr, int tc,
                                    int ratio, int pages, int ps, int rs, int64_t r0, int64_t p0, int64_t q0,
                                    int64_t t0, void* stream) {
    SlotShape s{rows, width, tr, tc, ratio, pages, r0, p0, q0, t0};
#define LAUNCH(P, R) \
    selected_global_slots<P, R><<<48, nullptr, stream>>>((GM_ADDR)r, (GM_ADDR)p, (GM_ADDR)q, (GM_ADDR)t, (GM_ADDR)o, s)
    if (ps == 4 && rs == 4) {
        LAUNCH(int32_t, int32_t);
    } else if (ps == 4) {
        LAUNCH(int32_t, int64_t);
    } else if (rs == 4) {
        LAUNCH(int64_t, int32_t);
    } else {
        LAUNCH(int64_t, int64_t);
    }
}
