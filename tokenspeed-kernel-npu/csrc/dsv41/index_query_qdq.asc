#include "kernel_operator.h"
using namespace AscendC;
union FloatBits {
    float f;
    uint32_t u;
};
struct QueryShape {
    int rows;
    int64_t stride;
};
__global__ __aicore__ void index_query_qdq(GM_ADDR xp, GM_ADDR yp, QueryShape shape) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    GlobalTensor<bfloat16_t> x, y;
    x.SetGlobalBuffer((__gm__ bfloat16_t*)xp);
    y.SetGlobalBuffer((__gm__ bfloat16_t*)yp);
    TBuf<> rawb, fb, ab, maxb, codeb, incb, maskb, onesb, zerosb, tmpb, outb, signb, bitsb;
    pipe.InitBuffer(rawb, 256);
    pipe.InitBuffer(fb, 512);
    pipe.InitBuffer(ab, 512);
    pipe.InitBuffer(maxb, 32);
    pipe.InitBuffer(codeb, 256);
    pipe.InitBuffer(incb, 256);
    pipe.InitBuffer(maskb, 32);
    pipe.InitBuffer(onesb, 256);
    pipe.InitBuffer(zerosb, 256);
    pipe.InitBuffer(tmpb, 512);
    pipe.InitBuffer(outb, 256);
    pipe.InitBuffer(signb, 256);
    pipe.InitBuffer(bitsb, 256);
    auto raw = rawb.Get<bfloat16_t>();
    auto f = fb.Get<float>();
    auto a = ab.Get<float>();
    auto maxima = maxb.Get<float>();
    auto code = codeb.Get<half>();
    auto inc = incb.Get<half>();
    auto mask = maskb.Get<uint8_t>();
    auto ones = onesb.Get<half>();
    auto zeros = zerosb.Get<half>();
    auto tmp = tmpb.Get<float>();
    auto out = outb.Get<bfloat16_t>();
    auto sign = signb.Get<uint16_t>();
    auto bits = bitsb.Get<uint16_t>();
    Duplicate(ones, (half)1, 128);
    Duplicate(zeros, (half)0, 128);
    Duplicate(bits, uint16_t(0x8000), 128);
    for (int row = GetBlockIdx(); row < shape.rows; row += GetBlockNum()) {
        DataCopy(raw, x[(int64_t)row * shape.stride], 128);
        SetFlag<HardEvent::MTE2_V>(0);
        WaitFlag<HardEvent::MTE2_V>(0);
        Cast(f, raw, RoundMode::CAST_NONE, 128);
        PipeBarrier<PIPE_V>();
        Abs(a, f, 128);
        And(sign, raw.ReinterpretCast<uint16_t>(), bits, 128);
        PipeBarrier<PIPE_V>();
        WholeReduceMax(maxima, a, 32, 4, 1, 1, 4, ReduceOrder::ORDER_ONLY_VALUE);
        SetFlag<HardEvent::V_S>(0);
        WaitFlag<HardEvent::V_S>(0);
        float scales[4];
        for (int g = 0; g < 4; g++) {
            float m = maxima.GetValue(g);
            FloatBits scaled;
            scaled.f = (m > 0x1.8p-124f ? m : 0x1.8p-124f) * (1.0f / 6.0f);
            uint32_t e = ((scaled.u >> 23) & 255) + ((scaled.u & 0x7fffff) != 0);
            FloatBits inv, scale;
            inv.u = (254 - e) << 23;
            scale.u = e << 23;
            scales[g] = scale.f;
            Muls(f[g * 32], f[g * 32], inv.f, 32);
        }
        PipeBarrier<PIPE_V>();
        Abs(a, f, 128);
        Duplicate(code, (half)0, 128);
        PipeBarrier<PIPE_V>();
        const float thresholds[7] = {0.25f, 0.75f, 1.25f, 1.75f, 2.5f, 3.5f, 5.f};
        for (int t = 0; t < 7; t++) {
            CompareScalar(mask, a, thresholds[t], (t & 1) ? CMPMODE::GE : CMPMODE::GT, 128);
            PipeBarrier<PIPE_V>();
            Select(inc, mask, ones, zeros, SELMODE::VSEL_TENSOR_TENSOR_MODE, 128);
            PipeBarrier<PIPE_V>();
            Add(code, code, inc, 128);
            PipeBarrier<PIPE_V>();
        }
        Cast(f, code, RoundMode::CAST_NONE, 128);
        PipeBarrier<PIPE_V>();
        Muls(a, f, 0.5f, 128);
        Adds(tmp, f, -2.f, 128);
        PipeBarrier<PIPE_V>();
        CompareScalar(mask, f, 4.f, CMPMODE::GE, 128);
        PipeBarrier<PIPE_V>();
        Select(a, mask, tmp, a, SELMODE::VSEL_TENSOR_TENSOR_MODE, 128);
        PipeBarrier<PIPE_V>();
        CompareScalar(mask, f, 7.f, CMPMODE::EQ, 128);
        Duplicate(tmp, 6.f, 128);
        PipeBarrier<PIPE_V>();
        Select(a, mask, tmp, a, SELMODE::VSEL_TENSOR_TENSOR_MODE, 128);
        PipeBarrier<PIPE_V>();
        for (int g = 0; g < 4; g++) Muls(a[g * 32], a[g * 32], scales[g], 32);
        // Match the current decoder, which canonicalizes quantized zero to +0.
        PipeBarrier<PIPE_V>();
        CompareScalar(mask, a, 0.f, CMPMODE::NE, 128);
        PipeBarrier<PIPE_V>();
        Select(sign.ReinterpretCast<half>(), mask, sign.ReinterpretCast<half>(), zeros,
               SELMODE::VSEL_TENSOR_TENSOR_MODE, 128);
        PipeBarrier<PIPE_V>();
        Cast(out, a, RoundMode::CAST_RINT, 128);
        PipeBarrier<PIPE_V>();
        Or(out.ReinterpretCast<uint16_t>(), out.ReinterpretCast<uint16_t>(), sign, 128);
        PipeBarrier<PIPE_V>();
        SetFlag<HardEvent::V_MTE3>(0);
        WaitFlag<HardEvent::V_MTE3>(0);
        DataCopy(y[(int64_t)row * 128], out, 128);
        SetFlag<HardEvent::MTE3_V>(0);
        WaitFlag<HardEvent::MTE3_V>(0);
        SetFlag<HardEvent::MTE3_MTE2>(0);
        WaitFlag<HardEvent::MTE3_MTE2>(0);
    }
}
extern "C" void launch_index_query_qdq(void* x, void* y, int rows, int64_t stride, void* stream) {
    QueryShape shape{rows, stride};
    index_query_qdq<<<48, nullptr, stream>>>((GM_ADDR)x, (GM_ADDR)y, shape);
}
