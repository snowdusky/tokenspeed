#include "kernel_operator.h"
using namespace AscendC;

// Clipped SwiGLU with the route weight read straight from the router output.
// Mirrors tokenspeed_kernel_npu/ops/dsv41_moe.py:_swiglu_with_route_weights.
struct SwigluRouteShape {
    int rows;      // expanded rows (destination space)
    int capacity;  // route count
    int k;         // top-k
    int h;         // intermediate width
    int experts;   // local expert count for the active-prefix sum
    int64_t x0;    // row stride of gate_up
    int64_t t0;    // stride of topk weights (row)
    int64_t t1;    // stride of topk weights (column)
    float limit;   // SwiGLU clip; <= 0 disables clipping
};

constexpr int MAXH = 2304;

__global__ __aicore__ void swiglu_route(GM_ADDR xp, GM_ADDR mp, GM_ADDR tp, GM_ADDR cp, GM_ADDR yp,
                                        SwigluRouteShape s) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    TBuf<> gbuf, ubuf, ybuf, rgb, rub, sbuf;
    pipe.InitBuffer(gbuf, MAXH * 4);
    pipe.InitBuffer(ubuf, MAXH * 4);
    pipe.InitBuffer(ybuf, MAXH * 4);
    pipe.InitBuffer(rgb, MAXH * 2);
    pipe.InitBuffer(rub, MAXH * 2);
    pipe.InitBuffer(sbuf, MAXH * 4);
    auto g = gbuf.Get<float>();
    auto u = ubuf.Get<float>();
    auto y = ybuf.Get<float>();
    auto rg = rgb.Get<bfloat16_t>();
    auto ru = rub.Get<bfloat16_t>();
    auto tmp = sbuf.Get<float>();

    GlobalTensor<bfloat16_t> X, Y;
    GlobalTensor<int32_t> Map;
    GlobalTensor<float> Topk;
    GlobalTensor<int64_t> Counts;
    X.SetGlobalBuffer((__gm__ bfloat16_t*)xp);
    Y.SetGlobalBuffer((__gm__ bfloat16_t*)yp);
    Map.SetGlobalBuffer((__gm__ int32_t*)mp);
    Topk.SetGlobalBuffer((__gm__ float*)tp);
    Counts.SetGlobalBuffer((__gm__ int64_t*)cp);

    const int h = s.h;
    // Rows below this prefix are the only ones this rank produced.
    int64_t valid = 0;
    for (int e = 0; e < s.experts; ++e) {
        valid += Counts.GetValue((int64_t)e);
    }
    if (valid > s.rows) {
        valid = s.rows;
    }

    for (int i = GetBlockIdx(); i < s.capacity; i += GetBlockNum()) {
        const int dst = Map.GetValue((int64_t)i);
        if (dst < 0 || dst >= valid) {
            continue;
        }
        const float w = Topk.GetValue((int64_t)(i / s.k) * s.t0 + (int64_t)(i % s.k) * s.t1);
        const int64_t base = (int64_t)dst * s.x0;
        DataCopyPad(rg, X[base], DataCopyExtParams{1, uint32_t(h * 2), 0, 0, 0},
                    DataCopyPadExtParams<bfloat16_t>{false, 0, 0, 0});
        DataCopyPad(ru, X[base + h], DataCopyExtParams{1, uint32_t(h * 2), 0, 0, 0},
                    DataCopyPadExtParams<bfloat16_t>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_V>(0);
        WaitFlag<HardEvent::MTE2_V>(0);
        Cast(g, rg, RoundMode::CAST_NONE, h);
        Cast(u, ru, RoundMode::CAST_NONE, h);
        PipeBarrier<PIPE_V>();
        // Reference clipping: gate from above only, up from both sides, and no
        // clipping at all when the limit is disabled (<= 0).
        if (s.limit > 0.0f) {
            Mins(g, g, s.limit, h);
            Mins(u, u, s.limit, h);
            Maxs(u, u, -s.limit, h);
            PipeBarrier<PIPE_V>();
        }
        Muls(tmp, g, -1.0f, h);
        PipeBarrier<PIPE_V>();
        Exp(tmp, tmp, h);
        PipeBarrier<PIPE_V>();
        Adds(tmp, tmp, 1.0f, h);
        PipeBarrier<PIPE_V>();
        Div(y, g, tmp, h);
        PipeBarrier<PIPE_V>();
        Mul(y, y, u, h);
        PipeBarrier<PIPE_V>();
        Muls(y, y, w, h);
        PipeBarrier<PIPE_V>();
        Cast(rg, y, RoundMode::CAST_RINT, h);
        SetFlag<HardEvent::V_MTE3>(0);
        WaitFlag<HardEvent::V_MTE3>(0);
        DataCopyPad(Y[(int64_t)dst * h], rg, DataCopyExtParams{1, uint32_t(h * 2), 0, 0, 0});
        SetFlag<HardEvent::MTE3_MTE2>(0);
        WaitFlag<HardEvent::MTE3_MTE2>(0);
    }
}

extern "C" void launch_swiglu_route(void* x, void* map, void* topk, void* counts, void* y, int rows,
                                    int capacity, int k, int h, int experts, int64_t x0, int64_t t0,
                                    int64_t t1, float limit, void* stream) {
    SwigluRouteShape s{rows, capacity, k, h, experts, x0, t0, t1, limit};
    swiglu_route<<<48, nullptr, stream>>>((GM_ADDR)x, (GM_ADDR)map, (GM_ADDR)topk, (GM_ADDR)counts,
                                          (GM_ADDR)y, s);
}
