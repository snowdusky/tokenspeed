#include "codec_bits.h"

// Split selected KV positions across AICs. Two AIVs gather/decode the tile and
// compute softmax; the paired AIC retains KV in L1 for QK and PV. 910B needs a
// GM mailbox between AIV and AIC, unlike 950's direct UB -> L1 transfer.
struct AttentionShape {
    int rows, heads, selected, swa_selected, swa_capacity, global_capacity, cores;
    int64_t swa_stride, global_stride;
    float scale;
    int paged;
    int sw_width, gl_width, meta_flags, row_owned;
    int64_t ss0, ss1, gs0, gs1, sl0, gl0;
};
constexpr int M = V41_HEAD_CAPACITY, H = M / 2, D = 512, B = KvCodec::B;
static_assert(M == 16 || M == 64);
constexpr SoftmaxConfig SM_CFG = {false, 0, 0, SoftmaxMode::SOFTMAX_OUTPUT_WITHOUT_BRC};
constexpr IsResetLoad3dConfig LD_CFG = {true, true};

template <int N>
struct CubeTile {
    TBuf<TPosition::A1> qBuf, kBuf, pBuf;
    TBuf<TPosition::A2> aBuf;
    TBuf<TPosition::B2> bBuf;
    TBuf<TPosition::CO1> cBuf;
    LocalTensor<bfloat16_t> q, k, p, a, b;
    LocalTensor<float> c;
    int iteration = 0, cIteration = 0, cSlot = 0;
    __aicore__ inline void Init(TPipe& pipe) {
        pipe.InitBuffer(qBuf, 2 * M * D * 2);
        pipe.InitBuffer(kBuf, 2 * N * D * 2);
        pipe.InitBuffer(pBuf, 2 * M * N * 2);
        pipe.InitBuffer(aBuf, 65536);
        pipe.InitBuffer(bBuf, 65536);
        pipe.InitBuffer(cBuf, 131072);
        q = qBuf.template Get<bfloat16_t>();
        k = kBuf.template Get<bfloat16_t>();
        p = pBuf.template Get<bfloat16_t>();
        a = aBuf.template Get<bfloat16_t>();
        b = bBuf.template Get<bfloat16_t>();
        c = cBuf.template Get<float>();
        SetFlag<HardEvent::M_MTE1>(3);
        SetFlag<HardEvent::M_MTE1>(4);
        SetFlag<HardEvent::FIX_M>(0);
        SetFlag<HardEvent::FIX_M>(1);
    }
    __aicore__ inline void Copy(LocalTensor<bfloat16_t> dst, GlobalTensor<bfloat16_t> src, int rows, int align,
                                int cols, int stride) {
        Nd2NzParams p{};
        p.ndNum = 1;
        p.nValue = rows;
        p.dValue = cols;
        p.srcDValue = stride;
        p.dstNzC0Stride = align;
        p.dstNzNStride = 1;
        DataCopy(dst, src, p);
    }
    __aicore__ inline void LoadA(LocalTensor<bfloat16_t> src, int m, int k) {
        LoadData3DParamsV2<bfloat16_t> p{};
        p.l1H = m / 16;
        p.l1W = 16;
        p.padList[3] = 255;
        p.mExtension = m;
        p.kExtension = k;
        p.strideW = p.strideH = p.filterW = p.filterH = 1;
        p.dilationFilterW = p.dilationFilterH = 1;
        p.channelSize = k;
        LoadData<bfloat16_t, LD_CFG>(a, src, p);
    }
    __aicore__ inline void LoadB(LocalTensor<bfloat16_t> src, int k, int n, bool transpose) {
        if (!transpose) {
            LoadData2DParams p{};
            p.repeatTimes = n / 16 * k / 16;
            p.srcStride = 1;
            LoadData(b, src, p);
        } else {
            LoadData3DParamsV2<bfloat16_t> p{};
            p.l1H = k / 16;
            p.l1W = 16;
            p.padList[3] = 255;
            p.mExtension = k;
            p.kExtension = n;
            p.strideW = p.strideH = p.filterW = p.filterH = 1;
            p.dilationFilterW = p.dilationFilterH = 1;
            p.channelSize = n;
            p.enTranspose = 1;
            LoadData<bfloat16_t, LD_CFG>(b, src, p);
        }
    }
    __aicore__ inline void Matmul(int n, int width, bool init, bool last) {
        int event = 3 + (iteration & 1);
        SetFlag<HardEvent::MTE1_M>(event);
        WaitFlag<HardEvent::MTE1_M>(event);
        MmadParams p{};
        p.m = M;
        p.n = n;
        p.k = width;
        p.cmatrixInitVal = init;
        p.cmatrixSource = false;
        p.unitFlag = 0;
        if (init) WaitFlag<HardEvent::FIX_M>(cSlot);
        Mmad(c, a, b, p);
        // MTE1 events only protect operands. Narrow M=16 tiles also need
        // to order consecutive writes to the FP32 accumulator.
        PipeBarrier<PIPE_M>();
        if (last) SetFlag<HardEvent::M_FIX>(cSlot);
        SetFlag<HardEvent::M_MTE1>(event);
        ++iteration;
    }
    __aicore__ inline void Store(GlobalTensor<float> dst, int n, int stride) {
        FixpipeParamsV220 p{};
        p.nSize = n;
        p.mSize = M;
        p.srcStride = M;
        p.dstStride = stride;
        p.ndNum = 1;
        p.unitFlag = 0;
        WaitFlag<HardEvent::M_FIX>(cSlot);
        Fixpipe(dst, c, p);
        SetFlag<HardEvent::FIX_M>(cSlot);
    }
    __aicore__ inline void Qk(GlobalTensor<float> logits) {
        SetFlag<HardEvent::MTE2_MTE1>(0);
        WaitFlag<HardEvent::MTE2_MTE1>(0);
        cSlot = cIteration++ & 1;
        c = cBuf.template Get<float>()[cSlot * 16384];
        for (int i = 0; i < 4; ++i) {
            WaitFlag<HardEvent::M_MTE1>(3 + (iteration & 1));
            a = aBuf.template Get<bfloat16_t>()[(iteration & 1) * 16384];
            b = bBuf.template Get<bfloat16_t>()[(iteration & 1) * 16384];
            LoadA(q[i * M * 128], M, 128);
            LoadB(k[i * N * 128], 128, N, false);
            Matmul(N, 128, i == 0, i == 3);
        }
        Store(logits, N, N);
    }
    __aicore__ inline void Pv(GlobalTensor<float> output) {
        SetFlag<HardEvent::MTE2_MTE1>(0);
        WaitFlag<HardEvent::MTE2_MTE1>(0);
        for (int i = 0; i < 4; ++i) {
            WaitFlag<HardEvent::M_MTE1>(3 + (iteration & 1));
            a = aBuf.template Get<bfloat16_t>()[(iteration & 1) * 16384];
            b = bBuf.template Get<bfloat16_t>()[(iteration & 1) * 16384];
            cSlot = cIteration++ & 1;
            c = cBuf.template Get<float>()[cSlot * 16384];
            LoadA(p, M, N);
            LoadB(k[i * N * 128], N, 128, true);
            Matmul(128, N, true, true);
            Store(output[i * 128], 128, D);
        }
    }
};

// Two raw-byte slots let the next gather overlap the current decode. Each
// slot is consumed before reuse; event 2 belongs only to this prefetch path.
template <int N>
__aicore__ inline void PrefetchPacked(LocalTensor<uint8_t> raw, GlobalTensor<uint8_t> cache, LocalTensor<int32_t> ids,
                                      LocalTensor<float> mask, int pos, int begin, int sub, int count, int capacity,
                                      int swaSelected, int64_t stride, bool isSwa, int paged) {
    int bytes = isSwa ? 544 : 288;
    Duplicate(raw.ReinterpretCast<uint16_t>(), uint16_t(0), B * bytes / 2);
    SetFlag<HardEvent::V_MTE2>(2);
    WaitFlag<HardEvent::V_MTE2>(2);
    for (int j = 0; j < B; ++j) {
        int id = ids.GetValue(pos + j);
        int position = begin + pos + j - (isSwa ? 0 : swaSelected);
        bool valid = id >= 0 && id < capacity && position < count;
        mask.SetValue(sub * N / 2 + pos + j, valid ? 0.f : -1e30f);
        if (valid) {
            if (paged) {
                int values = isSwa ? 512 : 256;
                int scales = isSwa ? 16 : 32;
                int64_t page = (int64_t)(id / 64) * stride;
                DataCopyPad(raw[j * bytes], cache[page + (id % 64) * values],
                            DataCopyExtParams{1, uint32_t(values), 0, 0, 0},
                            DataCopyPadExtParams<uint8_t>{false, 0, 0, 0});
                DataCopyPad(raw[j * bytes + values], cache[page + 64 * values + (id % 64) * scales],
                            DataCopyExtParams{1, uint32_t(scales), 0, 0, 0},
                            DataCopyPadExtParams<uint8_t>{false, 0, 0, 0});
            } else {
                DataCopyPad(raw[j * bytes], cache[(int64_t)id * stride],
                            DataCopyExtParams{1, uint32_t(isSwa ? 528 : 288), 0, 0, 0},
                            DataCopyPadExtParams<uint8_t>{false, 0, 0, 0});
            }
        }
    }
    SetFlag<HardEvent::MTE2_V>(2);
}

template <bool PACKED, int N>
__global__ __aicore__ void sparse_decode(GM_ADDR qp, GM_ADDR swp, GM_ADDR glp, GM_ADDR ssp, GM_ADDR gsp, GM_ADDR slp,
                                         GM_ADDR glenp, GM_ADDR tablep, GM_ADDR workspacep, GM_ADDR partialp,
                                         GM_ADDR statp, AttentionShape s) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    constexpr int KV_BYTES = N * D * 2, LOG_BYTES = M * N * 4, PROB_BYTES = M * N * 2;
    constexpr int CORE_BYTES = KV_BYTES + LOG_BYTES + PROB_BYTES + N * 4;
    int core = GetBlockIdx();
    int sub = 0;
    if ASCEND_IS_AIV {
        sub = core & 1;
        core /= 2;
    }
    GlobalTensor<bfloat16_t> query, kv, prob;
    GlobalTensor<uint8_t> swa, global;

    GlobalTensor<uint32_t> tables;
    GlobalTensor<float> logits, mask, partial, stats;
    query.SetGlobalBuffer((__gm__ bfloat16_t*)qp);
    swa.SetGlobalBuffer((__gm__ uint8_t*)swp);
    global.SetGlobalBuffer((__gm__ uint8_t*)glp);

    tables.SetGlobalBuffer((__gm__ uint32_t*)tablep);
    GM_ADDR base = workspacep + (int64_t)core * 2 * CORE_BYTES;
    kv.SetGlobalBuffer((__gm__ bfloat16_t*)base);
    logits.SetGlobalBuffer((__gm__ float*)(base + KV_BYTES));
    prob.SetGlobalBuffer((__gm__ bfloat16_t*)(base + KV_BYTES + LOG_BYTES));
    mask.SetGlobalBuffer((__gm__ float*)(base + KV_BYTES + LOG_BYTES + PROB_BYTES));
    partial.SetGlobalBuffer((__gm__ float*)partialp);
    stats.SetGlobalBuffer((__gm__ float*)statp);
    int parts = s.selected / N;
    TPipe pipe;
    if ASCEND_IS_AIC {
        int previousRows[2] = {-1, -1};
        CubeTile<N> cube;
        cube.Init(pipe);
        // Align mixed-core flags at every launch, including graph replay.
        CrossCoreWaitFlag(0);
        CrossCoreSetFlag<0x2, PIPE_FIX>(1);
        // Two independent KV/L1 and GM slots allow QK of the second tile
        // to overlap Softmax of the first. Keep each tile's arithmetic intact.
        for (int visit = 0;; visit += 2) {
            int tasks[2];
            int count = 0;
            for (int slot = 0; slot < 2; ++slot) {
                int v = visit + slot;
                int task = s.row_owned ? (core + v / parts * s.cores) * parts + v % parts : core + v * s.cores;
                if (task < s.rows * parts) tasks[count++] = task;
            }
            if (count == 0) break;
            for (int slot = 0; slot < count; ++slot) {
                int row = tasks[slot] / parts;
                if (slot == 0)
                    CrossCoreWaitFlag(0);
                else
                    CrossCoreWaitFlag(2);
                // Consecutive QK operations may still read the prior query in MTE1.
                cube.q = cube.qBuf.template Get<bfloat16_t>()[slot * M * D];
                if (row != previousRows[slot]) cube.Copy(cube.q, query[(int64_t)row * s.heads * D], s.heads, M, D, D);
                previousRows[slot] = row;
                cube.k = cube.kBuf.template Get<bfloat16_t>()[slot * N * D];
                cube.Copy(cube.k, kv[slot * CORE_BYTES / 2], N, N, D, D);
                cube.Qk(logits[slot * CORE_BYTES / 4]);
                if (slot == 0)
                    CrossCoreSetFlag<0x2, PIPE_FIX>(1);
                else
                    CrossCoreSetFlag<0x2, PIPE_FIX>(3);
            }
            for (int slot = 0; slot < count; ++slot) {
                if (slot == 0)
                    CrossCoreWaitFlag(4);
                else
                    CrossCoreWaitFlag(5);
                cube.k = cube.kBuf.template Get<bfloat16_t>()[slot * N * D];
                cube.p = cube.pBuf.template Get<bfloat16_t>()[slot * M * N];
                cube.Copy(cube.p, prob[slot * CORE_BYTES / 2], M, M, N, N);
                cube.Pv(partial[(int64_t)tasks[slot] * M * D]);
                if (slot == 0)
                    CrossCoreSetFlag<0x2, PIPE_FIX>(8);
                else
                    CrossCoreSetFlag<0x2, PIPE_FIX>(9);
            }
        }
        WaitFlag<HardEvent::M_MTE1>(3);
        WaitFlag<HardEvent::M_MTE1>(4);
        WaitFlag<HardEvent::FIX_M>(0);
        WaitFlag<HardEvent::FIX_M>(1);
    }
    if ASCEND_IS_AIV {
        KvCodec codec;
        TBuf<> idBuf, bfBuf, maskBuf, logBuf, pBuf, statBuf, softBuf, lenBuf, rawIdBuf;
        pipe.InitBuffer(idBuf, N / 2 * 4);
        if constexpr (!PACKED) pipe.InitBuffer(bfBuf, B * D * 2);
        pipe.InitBuffer(maskBuf, N * 4);
        if constexpr (!PACKED || M == 16) {
            pipe.InitBuffer(logBuf, H * N * 4);
            pipe.InitBuffer(pBuf, H * N * 2);
        }
        pipe.InitBuffer(statBuf, 6 * 32 * 4);
        pipe.InitBuffer(softBuf, 16 * 1024);
        pipe.InitBuffer(lenBuf, 32);
        pipe.InitBuffer(rawIdBuf, N / 2 * 32);
        auto ib = idBuf.Get<int32_t>();
        LocalTensor<bfloat16_t> bf;
        if constexpr (!PACKED) bf = bfBuf.Get<bfloat16_t>();
        auto mb = maskBuf.Get<float>();
        LocalTensor<float> lb;
        LocalTensor<bfloat16_t> pb;
        auto st = statBuf.Get<float>();
        auto sm = softBuf.Get<uint8_t>();
        auto ln = lenBuf.Get<int32_t>();
        auto rawIds = rawIdBuf.Get<uint8_t>();
        if constexpr (PACKED) codec.Init(pipe, tables);
        if constexpr (PACKED && M == 64) {
            // Decode scratch is dead after the gathered KV has reached GM.
            // Reuse it for softmax, keeping 64-head execution within 192 KiB UB.
            lb = codec.values;
            pb = codec.halves.ReinterpretCast<bfloat16_t>();
        } else {
            lb = logBuf.Get<float>();
            pb = pBuf.Get<bfloat16_t>();
        }
        CrossCoreSetFlag<0x2, PIPE_MTE3>(0);
        CrossCoreWaitFlag(1);
        int previousCount = 0;
        for (int visit = 0;; visit += 2) {
            int tasks[2];
            int count = 0;
            for (int slot = 0; slot < 2; ++slot) {
                int v = visit + slot;
                int task = s.row_owned ? (core + v / parts * s.cores) * parts + v % parts : core + v * s.cores;
                if (task < s.rows * parts) tasks[count++] = task;
            }
            if (count == 0) break;
            for (int slot = 0; slot < count; ++slot) {
                if (visit != 0) {
                    if (slot == 0)
                        CrossCoreWaitFlag(8);
                    else
                        CrossCoreWaitFlag(9);
                }
                int task = tasks[slot];
                int row = task / parts, part = task % parts, begin = part * N + sub * N / 2;
                bool isSwa = begin < s.swa_selected;
                int cap = isSwa ? s.swa_capacity : s.global_capacity;
                int64_t stride = isSwa ? s.swa_stride : s.global_stride;
                auto cache = isSwa ? swa : global;
                // Read the caller-owned tables directly. No concatenated IDs or lengths.
                int width = isSwa ? s.sw_width : s.gl_width;
                int relative = begin - (isSwa ? 0 : s.swa_selected);
                int valid = min(N / 2, max(0, width - relative));
                int flags = isSwa ? s.meta_flags : (s.meta_flags >> 3);
                bool wideIds = flags & 1, wideLength = flags & 2, hasLength = flags & 4;
                int elementBytes = wideIds ? 8 : 4;
                int64_t rowStride = isSwa ? s.ss0 : s.gs0;
                int64_t columnStride = isSwa ? s.ss1 : s.gs1;
                int64_t lengthStride = isSwa ? s.sl0 : s.gl0;
                GlobalTensor<uint8_t> sourceIds, sourceLength;
                sourceIds.SetGlobalBuffer((__gm__ uint8_t*)(isSwa ? ssp : gsp));
                sourceLength.SetGlobalBuffer((__gm__ uint8_t*)(isSwa ? slp : glenp));
                Duplicate(ib, int32_t(-1), N / 2);
                SetFlag<HardEvent::V_MTE2>(0);
                WaitFlag<HardEvent::V_MTE2>(0);
                if (valid > 0) {
                    int64_t offset = (row * rowStride + relative * columnStride) * elementBytes;
                    if (columnStride == 1) {
                        auto destination = wideIds ? rawIds : ib.ReinterpretCast<uint8_t>();
                        DataCopyPad(destination, sourceIds[offset],
                                    DataCopyExtParams{1, uint32_t(valid * elementBytes), 0, 0, 0},
                                    DataCopyPadExtParams<uint8_t>{false, 0, 0, 0});
                    } else if (columnStride == 0) {
                        DataCopyPad(rawIds, sourceIds[offset], DataCopyExtParams{1, uint32_t(elementBytes), 0, 0, 0},
                                    DataCopyPadExtParams<uint8_t>{false, 0, 0, 0});
                    } else {
                        // Strided metadata is legal; each element occupies one aligned UB block.
                        DataCopyPad(rawIds, sourceIds[offset],
                                    DataCopyExtParams{uint16_t(valid), uint32_t(elementBytes),
                                                      uint32_t((columnStride - 1) * elementBytes), 0, 0},
                                    DataCopyPadExtParams<uint8_t>{false, 0, 0, 0});
                    }
                }
                if (hasLength) {
                    DataCopyPad(ln.ReinterpretCast<uint8_t>(), sourceLength[row * lengthStride * (wideLength ? 8 : 4)],
                                DataCopyExtParams{1, uint32_t(wideLength ? 8 : 4), 0, 0, 0},
                                DataCopyPadExtParams<uint8_t>{false, 0, 0, 0});
                }
                SetFlag<HardEvent::MTE2_S>(0);
                WaitFlag<HardEvent::MTE2_S>(0);
                if (valid > 0 && (wideIds || columnStride != 1)) {
                    for (int j = 0; j < valid; ++j)
                        ib.SetValue(j, rawIds.ReinterpretCast<int32_t>().GetValue(
                                           j * (columnStride == 0 ? 0 : (columnStride == 1 ? 2 : 8))));
                }
                int64_t count64 = width;
                if (hasLength) count64 = wideLength ? ln.ReinterpretCast<int64_t>().GetValue(0) : ln.GetValue(0);
                int count = int(min(int64_t(width), max(int64_t(0), count64)));
                if constexpr (PACKED)
                    PrefetchPacked<N>(codec.rawBuf.template Get<uint8_t>(), cache, ib, mb, 0, begin, sub, count, cap,
                                      s.swa_selected, stride, isSwa, s.paged);
                for (int pos = 0; pos < N / 2; pos += B) {
                    if constexpr (PACKED) {
                        WaitFlag<HardEvent::MTE2_V>(2);
                        int slot = (pos / B) & 1;
                        if (pos + B < N / 2)
                            PrefetchPacked<N>(codec.rawBuf.template Get<uint8_t>()[(1 - slot) * B * 544], cache, ib, mb,
                                              pos + B, begin, sub, count, cap, s.swa_selected, stride, isSwa, s.paged);
                        codec.raw = codec.rawBuf.template Get<uint8_t>()[slot * B * 544];
                        // The preceding store owns only its selected half-buffer.
                        // Wait exactly when that buffer is reused two blocks later.
                        if (pos >= 2 * B) {
                            if (slot == 0)
                                WaitFlag<HardEvent::MTE3_V>(4);
                            else
                                WaitFlag<HardEvent::MTE3_V>(5);
                        }
                        codec.halves = codec.halfBuf.template Get<half>()[slot * B * D];
                        bf = isSwa ? codec.Decode<false>() : codec.Decode<true>();
                    } else {
                        auto raw = bf.ReinterpretCast<uint8_t>();
                        Duplicate(raw.ReinterpretCast<uint16_t>(), uint16_t(0), B * 1024 / 2);
                        SetFlag<HardEvent::V_MTE2>(0);
                        WaitFlag<HardEvent::V_MTE2>(0);
                        for (int j = 0; j < B; ++j) {
                            int id = ib.GetValue(pos + j);
                            int position = begin + pos + j - (isSwa ? 0 : s.swa_selected);
                            bool valid = id >= 0 && id < cap && position < count;
                            mb.SetValue(sub * N / 2 + pos + j, valid ? 0.f : -1e30f);
                            if (valid)
                                DataCopyPad(raw[j * 1024], cache[(int64_t)id * stride],
                                            DataCopyExtParams{1, 1024, 0, 0, 0},
                                            DataCopyPadExtParams<uint8_t>{false, 0, 0, 0});
                        }
                        SetFlag<HardEvent::MTE2_V>(0);
                        WaitFlag<HardEvent::MTE2_V>(0);
                    }
                    SetFlag<HardEvent::V_MTE3>(0);
                    WaitFlag<HardEvent::V_MTE3>(0);
                    DataCopy(kv[slot * CORE_BYTES / 2 + (sub * N / 2 + pos) * D], bf, B * D);
                    if constexpr (PACKED) {
                        if ((pos / B) & 1)
                            SetFlag<HardEvent::MTE3_V>(5);
                        else
                            SetFlag<HardEvent::MTE3_V>(4);
                    } else {
                        SetFlag<HardEvent::MTE3_V>(0);
                        WaitFlag<HardEvent::MTE3_V>(0);
                        SetFlag<HardEvent::MTE3_MTE2>(0);
                        WaitFlag<HardEvent::MTE3_MTE2>(0);
                    }
                }
                if constexpr (PACKED) {
                    WaitFlag<HardEvent::MTE3_V>(4);
                    WaitFlag<HardEvent::MTE3_V>(5);
                }
                SetFlag<HardEvent::S_MTE3>(0);
                WaitFlag<HardEvent::S_MTE3>(0);
                DataCopy(mask[slot * CORE_BYTES / 4 + sub * N / 2], mb[sub * N / 2], N / 2);
                // The next tile reuses mb through scalar SetValue. Retire its store first.
                SetFlag<HardEvent::MTE3_S>(1);
                WaitFlag<HardEvent::MTE3_S>(1);

                if (slot == 0)
                    CrossCoreSetFlag<0x2, PIPE_MTE3>(0);
                else
                    CrossCoreSetFlag<0x2, PIPE_MTE3>(2);
            }
            // A partial final pair must also retire the unused old slot.
            if (visit != 0 && count < previousCount) CrossCoreWaitFlag(9);
            for (int slot = 0; slot < count; ++slot) {
                int task = tasks[slot];
                if (slot == 0)
                    CrossCoreWaitFlag(1);
                else
                    CrossCoreWaitFlag(3);
                DataCopy(lb, logits[slot * CORE_BYTES / 4 + sub * H * N], H * N);
                DataCopy(mb, mask[slot * CORE_BYTES / 4], N);
                SetFlag<HardEvent::MTE2_V>(0);
                WaitFlag<HardEvent::MTE2_V>(0);
                Muls(lb, lb, s.scale, H * N);
                PipeBarrier<PIPE_V>();
                for (int h = 0; h < H; ++h) Add(lb[h * N], lb[h * N], mb, N);
                PipeBarrier<PIPE_V>();
                SoftMaxShapeInfo shape{H, N, H, N};
                auto tiling = SoftMaxFlashV2TilingFunc(shape, sizeof(float), sizeof(float), 16 * 1024, false, true);
                SoftmaxFlashV2<float, false, true, true, false, SM_CFG>(lb, st, st[32], lb, st[64], st[96], st[128], sm,
                                                                        tiling, shape);
                PipeBarrier<PIPE_V>();
                // All-invalid tiles must contribute zero to the final reduction.
                ReduceMax(st[160], mb, sm.ReinterpretCast<float>(), N);
                SetFlag<HardEvent::V_S>(0);
                WaitFlag<HardEvent::V_S>(0);
                if (st.GetValue(160) < 0.f) {
                    Duplicate(lb, 0.f, H * N);
                    Duplicate(st, 0.f, H);
                }
                PipeBarrier<PIPE_V>();
                Cast(pb, lb, RoundMode::CAST_RINT, H * N);
                SetFlag<HardEvent::V_MTE3>(0);
                WaitFlag<HardEvent::V_MTE3>(0);
                DataCopy(prob[slot * CORE_BYTES / 2 + sub * H * N], pb, H * N);
                DataCopy(stats[(int64_t)task * (2 * M) + sub * H], st, H);
                DataCopy(stats[(int64_t)task * (2 * M) + M + sub * H], st[32], H);

                if (slot == 0)
                    CrossCoreSetFlag<0x2, PIPE_MTE3>(4);
                else
                    CrossCoreSetFlag<0x2, PIPE_MTE3>(5);
                SetFlag<HardEvent::MTE3_V>(0);
                WaitFlag<HardEvent::MTE3_V>(0);
                SetFlag<HardEvent::MTE3_MTE2>(0);
                WaitFlag<HardEvent::MTE3_MTE2>(0);
            }
            previousCount = count;
        }
        if (previousCount > 0) CrossCoreWaitFlag(8);
        if (previousCount > 1) CrossCoreWaitFlag(9);
    }
}

extern "C" void launch_attention_codec_bits(void* q, void* sw, void* gl, void* ss, void* gs, void* sl, void* glength,
                                            void* table, void* ws, void* partial, void* stats, int rows, int heads,
                                            int selected, int swa_selected, int swa_cap, int global_cap,
                                            int64_t sw_stride, int64_t gl_stride, int packed, int tile, float scale,
                                            int paged, int sw_width, int gl_width, int flags, int64_t ss0, int64_t ss1,
                                            int64_t gs0, int64_t gs1, int64_t sl0, int64_t gl0, int row_owned,
                                            void* stream) {
    AttentionShape s{rows,      heads,     selected, swa_selected, swa_cap,  global_cap, 24,
                     sw_stride, gl_stride, scale,    paged,        sw_width, gl_width,   flags,
                     row_owned, ss0,       ss1,      gs0,          gs1,      sl0,        gl0};
#define LAUNCH(P, N)                                                                                             \
    sparse_decode<P, N><<<24, nullptr, stream>>>((GM_ADDR)q, (GM_ADDR)sw, (GM_ADDR)gl, (GM_ADDR)ss, (GM_ADDR)gs, \
                                                 (GM_ADDR)sl, (GM_ADDR)glength, (GM_ADDR)table, (GM_ADDR)ws,     \
                                                 (GM_ADDR)partial, (GM_ADDR)stats, s)
    if (tile == 64) {
        if (packed) {
            LAUNCH(true, 64);
        } else {
            LAUNCH(false, 64);
        }
    } else {
        if (packed) {
            LAUNCH(true, 128);
        } else {
            LAUNCH(false, 128);
        }
    }
#undef LAUNCH
}
