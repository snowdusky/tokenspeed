#include "kernel_operator.h"
using namespace AscendC;
struct RopeShape {
    int rows, heads, dim;
    int64_t x0, x1, p0, cs0;
};
__global__ __aicore__ void rope(GM_ADDR xp, GM_ADDR pp, GM_ADDR cp, RopeShape s) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    GlobalTensor<bfloat16_t> x;
    GlobalTensor<int64_t> pos;
    GlobalTensor<float> cs;
    x.SetGlobalBuffer((__gm__ bfloat16_t*)xp);
    pos.SetGlobalBuffer((__gm__ int64_t*)pp);
    cs.SetGlobalBuffer((__gm__ float*)cp);
    TBuf<TPosition::VECCALC> xb, fb, cb, eb, ob, tb, ub, yb, ib, jb, kb, lb;
    pipe.InitBuffer(xb, 1024);
    pipe.InitBuffer(fb, 2048);
    pipe.InitBuffer(cb, 256);
    pipe.InitBuffer(eb, 1024);
    pipe.InitBuffer(ob, 1024);
    pipe.InitBuffer(tb, 1024);
    pipe.InitBuffer(ub, 1024);
    pipe.InitBuffer(yb, 2048);
    pipe.InitBuffer(ib, 1024);
    pipe.InitBuffer(jb, 1024);
    pipe.InitBuffer(kb, 1024);
    pipe.InitBuffer(lb, 2048);
    auto raw = xb.Get<bfloat16_t>();
    auto f = fb.Get<float>();
    auto c = cb.Get<float>();
    auto even = eb.Get<float>();
    auto odd = ob.Get<float>();
    auto t = tb.Get<float>();
    auto u = ub.Get<float>();
    auto y = yb.Get<float>();
    auto ie = ib.Get<uint32_t>();
    auto io = jb.Get<uint32_t>();
    auto ic = kb.Get<uint32_t>();
    auto il = lb.Get<uint32_t>();
    for (int i = 0; i < 256; i++) {
        ie.SetValue(i, i * 8);
        io.SetValue(i, i * 8 + 4);
        ic.SetValue(i, (i % 32) * 4);
    }
    int groups = (s.heads + 7) / 8;
    for (int job = GetBlockIdx(); job < s.rows * groups; job += GetBlockNum()) {
        int row = job / groups, first = (job % groups) * 8, heads = (s.heads - first < 8 ? s.heads - first : 8),
            half = heads * 32, n = heads * 64;
        int64_t position = pos.GetValue((int64_t)row * s.p0);
        if (position < 0) position = 0;
        int64_t start = (int64_t)row * s.x0 + (int64_t)first * s.x1 + s.dim - 64;
        DataCopyPad(raw, x[start], DataCopyExtParams{(uint16_t)heads, 128, (uint32_t)(s.x1 * 2 - 128), 0, 0},
                    DataCopyPadExtParams<bfloat16_t>{false, 0, 0, 0});
        DataCopy(c, cs[position * s.cs0], 64);
        SetFlag<HardEvent::MTE2_V>(0);
        WaitFlag<HardEvent::MTE2_V>(0);
        Cast(f, raw, RoundMode::CAST_NONE, n);
        PipeBarrier<PIPE_V>();
        Gather(even, f, ie, 0, half);
        Gather(odd, f, io, 0, half);
        PipeBarrier<PIPE_V>();
        Gather(t, c, ic, 0, half);
        Gather(u, c[32], ic, 0, half);
        PipeBarrier<PIPE_V>();
        Mul(y, even, t, half);
        Mul(y[half], odd, u, half);
        PipeBarrier<PIPE_V>();
        Sub(y, y, y[half], half);
        PipeBarrier<PIPE_V>();
        Mul(t, odd, t, half);
        Mul(u, even, u, half);
        PipeBarrier<PIPE_V>();
        Add(y[half], t, u, half);
        PipeBarrier<PIPE_V>();
        for (int i = 0; i < n; i++) il.SetValue(i, (i / 2 + (i % 2) * half) * 4);
        Gather(f, y, il, 0, n);
        PipeBarrier<PIPE_V>();
        Cast(raw, f, RoundMode::CAST_RINT, n);
        SetFlag<HardEvent::V_MTE3>(0);
        WaitFlag<HardEvent::V_MTE3>(0);
        DataCopyPad(x[start], raw, DataCopyExtParams{(uint16_t)heads, 128, 0, (uint32_t)(s.x1 * 2 - 128), 0});
        SetFlag<HardEvent::MTE3_MTE2>(0);
        WaitFlag<HardEvent::MTE3_MTE2>(0);
        SetFlag<HardEvent::MTE3_V>(0);
        WaitFlag<HardEvent::MTE3_V>(0);
    }
}
extern "C" void launch_rope(void* x, void* p, void* c, int rows, int heads, int dim, int64_t x0, int64_t x1, int64_t p0,
                            int64_t cs0, void* stream) {
    rope<<<48, nullptr, stream>>>((GM_ADDR)x, (GM_ADDR)p, (GM_ADDR)c, RopeShape{rows, heads, dim, x0, x1, p0, cs0});
}
