#include "kernel_operator.h"
using namespace AscendC;
struct SwaPackShape {
    int rows, page_rows, pages, slot_bytes;
    int64_t x0, cp;
};
union FloatBits {
    float f;
    uint32_t u;
};
template <typename Slot>
__global__ __aicore__ void swa_pack(GM_ADDR xp, GM_ADDR sp, GM_ADDR cp, SwaPackShape s) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    GlobalTensor<bfloat16_t> x;
    GlobalTensor<Slot> slots;
    GlobalTensor<uint8_t> cache;
    x.SetGlobalBuffer((__gm__ bfloat16_t*)xp);
    slots.SetGlobalBuffer((__gm__ Slot*)sp);
    cache.SetGlobalBuffer((__gm__ uint8_t*)cp);
    TBuf<TPosition::VECCALC> rb, fb, ab, mb, yb, bb, tb, sb, nb, ub, vb, maskb, ob, scb;
    pipe.InitBuffer(rb, 1024);
    pipe.InitBuffer(fb, 2048);
    pipe.InitBuffer(ab, 2048);
    pipe.InitBuffer(mb, 64);
    pipe.InitBuffer(yb, 1024);
    pipe.InitBuffer(bb, 1024);
    pipe.InitBuffer(tb, 1024);
    pipe.InitBuffer(sb, 1024);
    pipe.InitBuffer(nb, 1024);
    pipe.InitBuffer(ub, 2048);
    pipe.InitBuffer(vb, 1024);
    pipe.InitBuffer(maskb, 64);
    pipe.InitBuffer(ob, 512);
    pipe.InitBuffer(scb, 32);
    auto raw = rb.Get<bfloat16_t>();
    auto f = fb.Get<float>();
    auto a = ab.Get<float>();
    auto maxima = mb.Get<float>();
    auto yr = yb.Get<bfloat16_t>();
    auto bits = bb.Get<uint16_t>();
    auto temp = tb.Get<uint16_t>();
    auto sign = sb.Get<uint16_t>();
    auto normal = nb.Get<half>();
    auto sub = ub.Get<float>();
    auto subhalf = vb.Get<half>();
    auto mask = maskb.Get<uint8_t>();
    auto out = ob.Get<uint8_t>();
    auto scales = scb.Get<uint8_t>();
    for (int row = GetBlockIdx(); row < s.rows; row += GetBlockNum()) {
        int64_t slot = s.slot_bytes ? slots.GetValue(row) : row;
        if (slot < 0 || slot >= (int64_t)s.pages * s.page_rows) continue;
        DataCopy(raw, x[(int64_t)row * s.x0], 512);
        SetFlag<HardEvent::MTE2_V>(0);
        WaitFlag<HardEvent::MTE2_V>(0);
        Cast(f, raw, RoundMode::CAST_NONE, 512);
        PipeBarrier<PIPE_V>();
        Abs(a, f, 512);
        PipeBarrier<PIPE_V>();
        WholeReduceMax(maxima, a, 32, 16, 1, 1, 4, ReduceOrder::ORDER_ONLY_VALUE);
        SetFlag<HardEvent::V_S>(0);
        WaitFlag<HardEvent::V_S>(0);
        for (int g = 0; g < 16; g++) {
            float m = maxima.GetValue(g);
            FloatBits scaled;
            scaled.f = (m > 1e-4f ? m : 1e-4f) * (1.0f / 448.0f);
            uint32_t e = (scaled.u >> 23) + ((scaled.u & 0x7fffff) != 0);
            scales.SetValue(g, (uint8_t)e);
            FloatBits inv;
            inv.u = (254 - e) << 23;
            Muls(f[g * 32], f[g * 32], inv.f, 32);
        }
        PipeBarrier<PIPE_V>();
        Cast(yr, f, RoundMode::CAST_RINT, 512);
        Abs(a, f, 512);
        PipeBarrier<PIPE_V>();
        ShiftRight(sign, yr.ReinterpretCast<uint16_t>(), (uint16_t)15, 512);
        ShiftLeft(bits, yr.ReinterpretCast<uint16_t>(), (uint16_t)1, 512);
        PipeBarrier<PIPE_V>();
        ShiftRight(bits, bits, (uint16_t)1, 512);
        ShiftLeft(sign, sign, (uint16_t)7, 512);
        PipeBarrier<PIPE_V>();
        ShiftRight(temp, bits, (uint16_t)4, 512);
        PipeBarrier<PIPE_V>();
        ShiftLeft(temp, temp, (uint16_t)15, 512);
        PipeBarrier<PIPE_V>();
        ShiftRight(temp, temp, (uint16_t)15, 512);
        PipeBarrier<PIPE_V>();
        Adds(bits.ReinterpretCast<int16_t>(), bits.ReinterpretCast<int16_t>(), (int16_t)7, 512);
        PipeBarrier<PIPE_V>();
        Add(bits.ReinterpretCast<int16_t>(), bits.ReinterpretCast<int16_t>(), temp.ReinterpretCast<int16_t>(), 512);
        PipeBarrier<PIPE_V>();
        ShiftRight(bits, bits, (uint16_t)4, 512);
        PipeBarrier<PIPE_V>();
        Adds(bits.ReinterpretCast<int16_t>(), bits.ReinterpretCast<int16_t>(), (int16_t)-960, 512);
        PipeBarrier<PIPE_V>();
        Mins(bits.ReinterpretCast<int16_t>(), bits.ReinterpretCast<int16_t>(), (int16_t)126, 512);
        PipeBarrier<PIPE_V>();
        Cast(normal, bits.ReinterpretCast<int16_t>(), RoundMode::CAST_NONE, 512);
        Mins(sub, a, 1.0f / 64.0f, 512);
        PipeBarrier<PIPE_V>();
        Muls(sub, sub, 512.0f, 512);
        PipeBarrier<PIPE_V>();
        Cast(temp.ReinterpretCast<int16_t>(), sub, RoundMode::CAST_RINT, 512);
        PipeBarrier<PIPE_V>();
        Cast(subhalf, temp.ReinterpretCast<int16_t>(), RoundMode::CAST_NONE, 512);
        CompareScalar(mask, a, 1.0f / 64.0f, CMPMODE::GE, 512);
        PipeBarrier<PIPE_V>();
        Select(normal, mask, normal, subhalf, SELMODE::VSEL_TENSOR_TENSOR_MODE, 512);
        PipeBarrier<PIPE_V>();
        Cast(subhalf, sign.ReinterpretCast<int16_t>(), RoundMode::CAST_NONE, 512);
        PipeBarrier<PIPE_V>();
        Add(normal, normal, subhalf, 512);
        PipeBarrier<PIPE_V>();
        Cast(out, normal, RoundMode::CAST_NONE, 512);
        SetFlag<HardEvent::V_MTE3>(0);
        WaitFlag<HardEvent::V_MTE3>(0);
        int64_t page = (slot / s.page_rows) * s.cp, local = slot % s.page_rows;
        DataCopy(cache[page + local * 512], out, 512);
        DataCopyPad(cache[page + (int64_t)s.page_rows * 512 + local * 16], scales, DataCopyExtParams{1, 16, 0, 0, 0});
        SetFlag<HardEvent::MTE3_MTE2>(0);
        WaitFlag<HardEvent::MTE3_MTE2>(0);
        SetFlag<HardEvent::MTE3_V>(0);
        WaitFlag<HardEvent::MTE3_V>(0);
    }
}
extern "C" void launch_swa_pack(void* x, void* s, void* c, int rows, int page_rows, int pages, int slot_bytes,
                                int64_t x0, int64_t cp, void* stream) {
    SwaPackShape shape{rows, page_rows, pages, slot_bytes, x0, cp};
    if (slot_bytes == 4)
        swa_pack<int32_t><<<48, nullptr, stream>>>((GM_ADDR)x, (GM_ADDR)s, (GM_ADDR)c, shape);
    else
        swa_pack<int64_t><<<48, nullptr, stream>>>((GM_ADDR)x, (GM_ADDR)s, (GM_ADDR)c, shape);
}
