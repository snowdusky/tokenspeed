#include "kernel_operator.h"
using namespace AscendC;
struct GlobalPackShape {
    int rows, page_rows, pages, slot_bytes;
    int64_t x0, cp;
};
union GlobalFloatBits {
    float f;
    uint32_t u;
};
template <typename Slot>
__global__ __aicore__ void global_pack_native(GM_ADDR xp, GM_ADDR sp, GM_ADDR cp, GlobalPackShape s) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    GlobalTensor<bfloat16_t> x;
    GlobalTensor<Slot> slots;
    GlobalTensor<uint8_t> cache;
    x.SetGlobalBuffer((__gm__ bfloat16_t*)xp);
    slots.SetGlobalBuffer((__gm__ Slot*)sp);
    cache.SetGlobalBuffer((__gm__ uint8_t*)cp);
    TBuf<TPosition::VECCALC> rb, fb, ab, mb, cb, ib, maskb, oneb, zerob, sb, ob, lb, hb, mask16b, finalb, scb, factorb,
        thresholdb;
    pipe.InitBuffer(rb, 256);
    pipe.InitBuffer(fb, 512);
    pipe.InitBuffer(ab, 512);
    pipe.InitBuffer(mb, 32);
    pipe.InitBuffer(cb, 256);
    pipe.InitBuffer(ib, 256);
    pipe.InitBuffer(maskb, 32);
    pipe.InitBuffer(oneb, 256);
    pipe.InitBuffer(zerob, 256);
    pipe.InitBuffer(sb, 256);
    pipe.InitBuffer(ob, 128);
    pipe.InitBuffer(lb, 128);
    pipe.InitBuffer(hb, 128);
    pipe.InitBuffer(mask16b, 128);
    pipe.InitBuffer(finalb, 64);
    pipe.InitBuffer(scb, 32);
    pipe.InitBuffer(factorb, 512);
    pipe.InitBuffer(thresholdb, 512);
    auto raw = rb.Get<bfloat16_t>();
    auto f = fb.Get<float>();
    auto a = ab.Get<float>();
    auto maxima = mb.Get<float>();
    auto code = cb.Get<half>();
    auto inc = ib.Get<half>();
    auto mask = maskb.Get<uint8_t>();
    auto ones = oneb.Get<half>();
    auto zeros = zerob.Get<half>();
    auto sign = sb.Get<uint16_t>();
    auto bytes = ob.Get<uint8_t>();
    auto lo = lb.Get<uint16_t>();
    auto hi = hb.Get<uint16_t>();
    auto bitmask = mask16b.Get<uint16_t>();
    auto out = finalb.Get<uint8_t>();
    auto scales = scb.Get<uint8_t>();
    auto factors = factorb.Get<float>();
    auto threshold = thresholdb.Get<float>();
    Duplicate(ones, (half)1, 128);
    Duplicate(zeros, (half)0, 128);
    for (int task = GetBlockIdx(); task < s.rows * 4; task += GetBlockNum()) {
        int row = task / 4, tile = task % 4;
        int64_t slot = s.slot_bytes ? slots.GetValue(row) : row;
        if (slot < 0 || slot >= (int64_t)s.pages * s.page_rows) continue;
        DataCopy(raw, x[(int64_t)row * s.x0 + tile * 128], 128);
        SetFlag<HardEvent::MTE2_V>(0);
        WaitFlag<HardEvent::MTE2_V>(0);
        Cast(f, raw, RoundMode::CAST_NONE, 128);
        PipeBarrier<PIPE_V>();
        Abs(a, f, 128);
        PipeBarrier<PIPE_V>();
        WholeReduceMax(maxima, a, 16, 8, 1, 1, 2, ReduceOrder::ORDER_ONLY_VALUE);
        SetFlag<HardEvent::V_S>(0);
        WaitFlag<HardEvent::V_S>(0);
        for (int g = 0; g < 8; g++) {
            // Every maximum is an exactly represented BF16 value. Multiplication by
            // 1/6 produces the same E4M3 scale codes as division for every finite BF16.
            float m = maxima.GetValue(g);
            float amax = (m > 0x1.8p-7f ? m : 0x1.8p-7f) * (1.0f / 6.0f);
            amax = amax < 448.f ? amax : 448.f;
            GlobalFloatBits bits;
            bits.f = amax;
            int e = int((bits.u >> 23) & 255) - 127;
            e = e > -6 ? e : -6;
            GlobalFloatBits factor;
            factor.u = uint32_t(130 - e) << 23;
            float scaled = amax * factor.f;
            int low = int(scaled);
            float fraction = scaled - float(low);
            int rounded = low + int(fraction > 0.5f || (fraction == 0.5f && (low & 1)));
            int code = (e + 6) * 8 + rounded;
            scales.SetValue(g, uint8_t(code));
            int exponent = code >> 3, mantissa = code & 7;
            GlobalFloatBits decoded;
            decoded.u = uint32_t(exponent + 120) << 23 | uint32_t(mantissa) << 20;
            float scale = exponent ? decoded.f : float(mantissa) * 0x1p-9f;
            Duplicate(factors[g * 16], scale, 16);
        }
        PipeBarrier<PIPE_V>();
        Duplicate(code, (half)0, 128);
        PipeBarrier<PIPE_V>();
        // Nearest code, ties to even, including the sign of zero.
        const float thresholds[7] = {0.25f, 0.75f, 1.25f, 1.75f, 2.5f, 3.5f, 5.0f};
        for (int t = 0; t < 7; t++) {
            Muls(threshold, factors, thresholds[t], 128);
            PipeBarrier<PIPE_V>();
            Compare(mask, a, threshold, (t & 1) ? CMPMODE::GE : CMPMODE::GT, 128);
            PipeBarrier<PIPE_V>();
            Select(inc, mask, ones, zeros, SELMODE::VSEL_TENSOR_TENSOR_MODE, 128);
            PipeBarrier<PIPE_V>();
            Add(code, code, inc, 128);
            PipeBarrier<PIPE_V>();
        }
        ShiftRight(sign, raw.ReinterpretCast<uint16_t>(), (uint16_t)15, 128);
        PipeBarrier<PIPE_V>();
        ShiftLeft(sign, sign, (uint16_t)3, 128);
        PipeBarrier<PIPE_V>();
        Cast(inc, sign.ReinterpretCast<int16_t>(), RoundMode::CAST_NONE, 128);
        PipeBarrier<PIPE_V>();
        Add(code, code, inc, 128);
        PipeBarrier<PIPE_V>();
        Cast(bytes, code, RoundMode::CAST_NONE, 128);
        Duplicate(bitmask, (uint16_t)15, 64);
        PipeBarrier<PIPE_V>();
        And(lo, bytes.ReinterpretCast<uint16_t>(), bitmask, 64);
        ShiftRight(hi, bytes.ReinterpretCast<uint16_t>(), (uint16_t)4, 64);
        PipeBarrier<PIPE_V>();
        Duplicate(bitmask, (uint16_t)240, 64);
        PipeBarrier<PIPE_V>();
        And(hi, hi, bitmask, 64);
        PipeBarrier<PIPE_V>();
        Or(lo, lo, hi, 64);
        PipeBarrier<PIPE_V>();
        Cast(inc, lo.ReinterpretCast<int16_t>(), RoundMode::CAST_NONE, 64);
        PipeBarrier<PIPE_V>();
        Cast(out, inc, RoundMode::CAST_NONE, 64);
        SetFlag<HardEvent::V_MTE3>(0);
        WaitFlag<HardEvent::V_MTE3>(0);
        int64_t page = (slot / s.page_rows) * s.cp, local = slot % s.page_rows;
        DataCopy(cache[page + local * 256 + tile * 64], out, 64);
        DataCopyPad(cache[page + (int64_t)s.page_rows * 256 + local * 32 + tile * 8], scales,
                    DataCopyExtParams{1, 8, 0, 0, 0});
        SetFlag<HardEvent::MTE3_MTE2>(0);
        WaitFlag<HardEvent::MTE3_MTE2>(0);
        SetFlag<HardEvent::MTE3_V>(0);
        WaitFlag<HardEvent::MTE3_V>(0);
    }
}
extern "C" void launch_global_pack(void* x, void* s, void* c, int rows, int page_rows, int pages, int slot_bytes,
                                   int64_t x0, int64_t cp, void* stream) {
    GlobalPackShape shape{rows, page_rows, pages, slot_bytes, x0, cp};
    if (slot_bytes == 4)
        global_pack_native<int32_t><<<48, nullptr, stream>>>((GM_ADDR)x, (GM_ADDR)s, (GM_ADDR)c, shape);
    else
        global_pack_native<int64_t><<<48, nullptr, stream>>>((GM_ADDR)x, (GM_ADDR)s, (GM_ADDR)c, shape);
}
