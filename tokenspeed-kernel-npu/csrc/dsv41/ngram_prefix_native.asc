#include "kernel_operator.h"
#include "utils/debug/asc_assert.h"
using namespace AscendC;

__global__ __aicore__ void ngram_prefix(GM_ADDR snapshots, GM_ADDR positions, GM_ADDR reset, GM_ADDR slots,
                                        GM_ADDR cache_lengths, GM_ADDR tail, GM_ADDR needs_seed, GM_ADDR prefix, int bs,
                                        int vocab, int cache_bytes, int reset_bytes) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    GlobalTensor<int64_t> snapshot, position, slot, old_tail, output;
    GlobalTensor<int32_t> cache32;
    GlobalTensor<int64_t> cache64;
    GlobalTensor<uint8_t> reset_flag, seed_flag;
    GlobalTensor<int64_t> reset64;
    snapshot.SetGlobalBuffer((__gm__ int64_t*)snapshots);
    position.SetGlobalBuffer((__gm__ int64_t*)positions);
    slot.SetGlobalBuffer((__gm__ int64_t*)slots);
    old_tail.SetGlobalBuffer((__gm__ int64_t*)tail);
    output.SetGlobalBuffer((__gm__ int64_t*)prefix);
    cache32.SetGlobalBuffer((__gm__ int32_t*)cache_lengths);
    cache64.SetGlobalBuffer((__gm__ int64_t*)cache_lengths);
    reset_flag.SetGlobalBuffer((__gm__ uint8_t*)reset);
    reset64.SetGlobalBuffer((__gm__ int64_t*)reset);
    seed_flag.SetGlobalBuffer((__gm__ uint8_t*)needs_seed);
    // Eight histories occupy exactly three 64-byte cache lines. Scalar GM
    // stores from different cores must never update one shared cache line.
    for (int block = GetBlockIdx(); block < (bs + 7) / 8; block += GetBlockNum()) {
        for (int row = block * 8; row < bs && row < (block + 1) * 8; ++row) {
            const int64_t owner = slot.GetValue(row);
            const bool seed = (reset_bytes == 1 ? reset_flag.GetValue(row) != 0 : reset64.GetValue(row) != 0) ||
                              seed_flag.GetValue(owner);
            const int64_t accepted = cache_bytes == 4 ? cache32.GetValue(owner) : cache64.GetValue(owner);
            const int64_t delta = accepted - position.GetValue(row);
            assert(!seed || (delta >= 0 && delta <= 1));
            for (int col = 0; col < 3; ++col) {
                const int64_t value =
                    seed ? snapshot.GetValue(row * 4 + col + 1 - delta) : old_tail.GetValue(owner * 3 + col);
                output.SetValue(row * 3 + col, value >= 0 && value < vocab ? value : -1);
            }
        }
    }
}
extern "C" void launch_ngram_prefix(void* snapshots, void* positions, void* reset, void* slots, void* cache_lengths,
                                    void* tail, void* needs_seed, void* prefix, int bs, int vocab, int cache_bytes,
                                    int reset_bytes, void* stream) {
    ngram_prefix<<<(bs + 7) / 8 < 48 ? (bs + 7) / 8 : 48, nullptr, stream>>>(
        (GM_ADDR)snapshots, (GM_ADDR)positions, (GM_ADDR)reset, (GM_ADDR)slots, (GM_ADDR)cache_lengths, (GM_ADDR)tail,
        (GM_ADDR)needs_seed, (GM_ADDR)prefix, bs, vocab, cache_bytes, reset_bytes);
}
