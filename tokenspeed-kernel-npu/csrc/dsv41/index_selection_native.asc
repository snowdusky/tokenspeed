#include "kernel_operator.h"
using namespace AscendC;
union SelectionBits {
    float f;
    uint32_t u;
};
struct FinishShape {
    int rows, k, width;
    int64_t input_stride, output_stride;
};
__global__ __aicore__ void selection_finish(GM_ADDR xp, GM_ADDR yp, FinishShape s) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    constexpr int B = 256;
    TPipe pipe;
    TBuf<> ib, ob, mb, nb;
    pipe.InitBuffer(ib, B * 4);
    pipe.InitBuffer(ob, B * 4);
    pipe.InitBuffer(mb, 32);
    pipe.InitBuffer(nb, B * 4);
    auto input = ib.Get<float>();
    auto output = ob.Get<int32_t>();
    auto mask = mb.Get<uint8_t>();
    auto negative = nb.Get<float>();
    GlobalTensor<float> x;
    GlobalTensor<int32_t> y;
    x.SetGlobalBuffer((__gm__ float*)xp);
    y.SetGlobalBuffer((__gm__ int32_t*)yp);
    SelectionBits infinity;
    infinity.u = 0x7f800000u;
    Duplicate(negative, -1.f, B);
    int tiles = (s.width + B - 1) / B;
    for (int job = GetBlockIdx(); job < s.rows * tiles; job += GetBlockNum()) {
        int row = job / tiles, col = (job % tiles) * B;
        int count = s.k - col;
        count = count < 0 ? 0 : (count > B ? B : count);
        int stores = s.width - col;
        stores = stores > B ? B : stores;
        Duplicate(input, infinity.f, B);
        SetFlag<HardEvent::V_MTE2>(0);
        WaitFlag<HardEvent::V_MTE2>(0);
        if (count)
            DataCopyPad(input, x[(int64_t)row * s.input_stride + col],
                        DataCopyExtParams{1, uint32_t(count * 4), 0, 0, 0},
                        DataCopyPadExtParams<float>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_V>(0);
        WaitFlag<HardEvent::MTE2_V>(0);
        CompareScalar(mask, input, infinity.f, CMPMODE::LT, B);
        PipeBarrier<PIPE_V>();
        Select(input, mask, input, negative, SELMODE::VSEL_TENSOR_TENSOR_MODE, B);
        PipeBarrier<PIPE_V>();
        Cast(output, input, RoundMode::CAST_RINT, B);
        SetFlag<HardEvent::V_MTE3>(0);
        WaitFlag<HardEvent::V_MTE3>(0);
        DataCopyPad(y[(int64_t)row * s.output_stride + col], output,
                    DataCopyExtParams{1, uint32_t(stores * 4), 0, 0, 0});
        SetFlag<HardEvent::MTE3_V>(0);
        WaitFlag<HardEvent::MTE3_V>(0);
        SetFlag<HardEvent::MTE3_MTE2>(0);
        WaitFlag<HardEvent::MTE3_MTE2>(0);
    }
}
struct BlockShape {
    int rows, width;
    int64_t score_stride, visible_stride;
};
__global__ __aicore__ void selection_block_scores(GM_ADDR xp, GM_ADDR vp, GM_ADDR yp, BlockShape s) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    constexpr int B = 128;
    TPipe pipe;
    TBuf<> ib, ob;
    pipe.InitBuffer(ib, B * 8 * 4);
    pipe.InitBuffer(ob, B * 4);
    auto input = ib.Get<float>();
    auto output = ob.Get<float>();
    GlobalTensor<float> x, y;
    GlobalTensor<int32_t> v;
    x.SetGlobalBuffer((__gm__ float*)xp);
    y.SetGlobalBuffer((__gm__ float*)yp);
    v.SetGlobalBuffer((__gm__ int32_t*)vp);
    SelectionBits inf;
    inf.u = 0x7f800000u;
    int blocks = s.width / 8, tiles = (blocks + B - 1) / B;
    for (int job = GetBlockIdx(); job < s.rows * tiles; job += GetBlockNum()) {
        int row = job / tiles, col = (job % tiles) * B, count = blocks - col;
        count = count > B ? B : count;
        Duplicate(input, -inf.f, B * 8);
        SetFlag<HardEvent::V_MTE2>(0);
        WaitFlag<HardEvent::V_MTE2>(0);
        DataCopyPad(input, x[(int64_t)row * s.score_stride + col * 8],
                    DataCopyExtParams{1, uint32_t(count * 8 * 4), 0, 0, 0},
                    DataCopyPadExtParams<float>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_V>(0);
        WaitFlag<HardEvent::MTE2_V>(0);
        WholeReduceMax(output, input, 8, B, 1, 1, 1, ReduceOrder::ORDER_ONLY_VALUE);
        SetFlag<HardEvent::V_S>(0);
        WaitFlag<HardEvent::V_S>(0);
        int visible = v.GetValue((int64_t)row * s.visible_stride);
        visible = visible < 0 ? 0 : (visible > s.width ? s.width : visible);
        int latest = visible ? ((visible - 1) / 8) : -1;
        if (latest >= col && latest < col + count && output.GetValue(latest - col) > -inf.f)
            output.SetValue(latest - col, inf.f);
        SetFlag<HardEvent::S_MTE3>(0);
        WaitFlag<HardEvent::S_MTE3>(0);
        SetFlag<HardEvent::V_MTE3>(0);
        WaitFlag<HardEvent::V_MTE3>(0);
        DataCopyPad(y[(int64_t)row * blocks + col], output, DataCopyExtParams{1, uint32_t(count * 4), 0, 0, 0});
        SetFlag<HardEvent::MTE3_V>(0);
        WaitFlag<HardEvent::MTE3_V>(0);
        SetFlag<HardEvent::MTE3_MTE2>(0);
        WaitFlag<HardEvent::MTE3_MTE2>(0);
    }
}
extern "C" void launch_selection_finish(void* x, void* y, int rows, int k, int width, int64_t xs, int64_t ys,
                                        void* stream) {
    FinishShape s{rows, k, width, xs, ys};
    selection_finish<<<48, nullptr, stream>>>((GM_ADDR)x, (GM_ADDR)y, s);
}
extern "C" void launch_selection_block_scores(void* x, void* v, void* y, int rows, int width, int64_t xs, int64_t vs,
                                              void* stream) {
    BlockShape s{rows, width, xs, vs};
    selection_block_scores<<<48, nullptr, stream>>>((GM_ADDR)x, (GM_ADDR)v, (GM_ADDR)y, s);
}
